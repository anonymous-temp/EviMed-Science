# ─── Drug Safety Analysis Agent configuration ───────────────────────

# ── LLM (DeepSeek, two-tier routing) ─────────────────────────────────
# NOTE: not used by the P2/P3 data + statistics layers; required from P4 on.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# ── openFDA ──────────────────────────────────────────────────────────
OPENFDA_BASE_URL=https://api.fda.gov
# Optional. Without a key openFDA allows 240 requests/minute/IP, which is
# enough for one analysis (~20-40 count queries) with caching enabled.
OPENFDA_API_KEY=

# Optional reproducible, report-level SQLite snapshot generated from quarterly
# FAERS DEMO/DRUG/REAC files. JSON is supported only for small regression
# fixtures. Statistics bind drug name and ROLE_COD on the same drug row.
FAERS_SNAPSHOT_PATH=
# Optional inclusive analysis universe within the immutable snapshot.
FAERS_STUDY_DATE_FROM=
FAERS_STUDY_DATE_TO=
# Optional fitted GPS prior artifact. It is rejected unless both its snapshot_id
# and canonical snapshot SHA-256 match FAERS_SNAPSHOT_PATH exactly.
GPS_PRIOR_ARTIFACT_PATH=

# ── Response cache (memory + disk, two-level) ────────────────────────
CACHE_DIR=.cache/openfda
CACHE_TTL_HOURS=24

# ── Java WebSocket backend (P5; mirrors the other Python agents) ──────
# JAVA_WS_URL=ws://192.168.20.252:2066/ws/ws
# JAVA_TOKEN_URL=http://192.168.20.252:2066/api-evimed/ai-agent/token?clientType=drug-safety-analysis
# Production:
JAVA_WS_URL=wss://evidence-factory.evimed.com/ws/ws
JAVA_TOKEN_URL=https://evidence-factory.evimed.com/api-evimed/ai-agent/token?clientType=drug-safety-analysis

# ── OSS object storage (report upload, P5) ────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=project-beijing-a4hznzutlh
OSS_PUBLIC_BASE_URL=https://image.evimed.com/oss

# ── EviMed evidence retrieval API ────────────────────────────────────
EVIMED_EVIDENCE_SEARCH_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api
# Prefer an owner-readable secret file. The direct value remains available
# only for managed secret injection and must never be committed.
EVIMED_EVIDENCE_SEARCH_KEY_FILE=
EVIMED_EVIDENCE_SEARCH_KEY=

# ── Service ───────────────────────────────────────────────────────────
SERVICE_PORT=6010
LOG_LEVEL=INFO
# 最大并发会话数(WS 会话 + 后台分析任务)
MAX_CONCURRENT_SESSIONS=8
