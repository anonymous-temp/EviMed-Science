","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-8245-7693","authenticated-orcid":false,"given":"Youngsung","family":"Joo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"container-title":["Nature Communications"]},{"DOI":"10.1038\/s41467-026-77777-6","title":["Near-Zero Creep Ionic Elastomer for Non-drifting Ear Electroencephalogram Signal Acquisition"],"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T10:04:42Z","timestamp":1789466682000},"published":{"date-parts":[[2026,9,15]]},"type":"journal-article","author":[{"given":"Ruiming","family":"Liu","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xueyang","family":"Ge","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Xiaojun","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Zijun","family":"Xu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-3839-2965","authenticated-orcid":false,"given":"Yanning","family":"Zhang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-2760-4598","authenticated-orcid":false,"given":"Xiaosen","family":"Pan","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Zhenwen","family":"Li","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Lihong","family":"Yang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-4687-1747","authenticated-orcid":false,"given":"Qin","family":"Yue","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"container-title":["Nature Communications"]},{"DOI":"10.1038\/s41467-026-76619-9","title":["Tunneling nanotubes regulate mitochondrial homeostasis between glioblastoma and astrocytes, and between tumor cells in vivo"],"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T09:04:57Z","timestamp":1789463097000},"published":{"date-parts":[[2026,9,15]]},"type":"journal-article","abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>Tumor progression is driven by cancer cells\u2019 ability to establish a cellular network through tunneling nanotube-like connections (TNTs), which enable mitochondrial exchange both within the tumor cells and with the tumor microenvironment (TME). However, the functional consequences of mitochondrial transfer between tumor and non-tumor cells, and its occurrence in vivo, remain poorly understood. Here we show bidirectional mitochondrial transfer between Glioblastoma (GBM) cells and non-tumoral astrocytes (AS). We report that transfer of damaged mitochondria from GBM cells to AS is associated with activation of mitophagy in recipient cells, while astrocyte-derived mitochondria to GBM cells correlates with changes in mitochondrial activity and metabolic readouts. Furthermore, intravital subcellular microscopy (ISMic) in a live animal model allows the visualization of TNT connections with characteristics similar to those observed in vitro and supported TNT-mediated mitochondrial transfer in vivo. These findings reveal a potential mechanism of tumor adaptation and highlight TNTs as promising therapeutic targets.<\/jats:p>","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-1868-3001","authenticated-orcid":false,"given":"Ines","family":"Saenz-de-Santa-Maria","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Anna","family":"Pepe","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0998-4718","authenticated-orcid":false,"given":"Jean-Yves","family":"Tinevez","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0229-8202","authenticated-orcid":false,"given":"Christel","family":"Brou","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yakov","family":"Vitrenko","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-6286-1138","authenticated-orcid":false,"given":"Thomas","family":"Cokelaer","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Elizabeth","family":"Cohen-Jonathan Moyal","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0740-4465","authenticated-orcid":false,"given":"Roberto","family":"Weigert","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-6048-6602","authenticated-orcid":false,"given":"Chiara","family":"Zurzolo","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"container-title":["Nature Communications"]},{"DOI":"10.1038\/s41467-026-77396-1","title":["Lignin-dynamic networks break the strength\u2013toughness trade-off in thermoplastic elastomers"],"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T09:03:49Z","timestamp":1789463029000},"published":{"date-parts":[[2026,9,15]]},"type":"journal-article","author":[{"given":"Peng","family":"Zhao","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tianwei","family":"Wu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jinsong","family":"Sun","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Meng","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Qi","family":"Tang","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Zechun","family":"Ren","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5609-9180","authenticated-orcid":false,"given":"Yongzhuang","family":"Liu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0634-7913","authenticated-orcid":false,"given":"Haipeng","family":"Yu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"container-title":["Nature Communications"]},{"DOI":"10.1038\/s41467-026-77554-5","title":["Two-photon excited circularly polarized luminescence of hetero[9]helicene with multiresonant thermally activated delayed fluorescence"],"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T08:09:41Z","timestamp":1789459781000},"published":{"date-parts":[[2026,9,15]]},"type":"journal-article","abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    Circularly polarized luminescence (CPL) imaging of biomolecules using designed chiral probes holds significant promise for biochemical and analytical applications. In this work, we report two chiral hetero[9]helicene multi-resonant thermally activated delayed fluorescent (MR-TADF) organic molecules\n                    <jats:bold>DDCzBPh<\/jats:bold>\n                    and\n                    <jats:bold>DDCzBPy<\/jats:bold>\n                    , consisting of two annulated MR-TADF units to a central naphthyl or quinoxanyl group, respectively, which exhibit simultaneously strong CPL, two-photon absorption, high photoluminescence quantum yields, and long-lived delayed fluorescence. We demonstrate two-photon-excited CPL of TADF emitters, with their circularly polarized brightness of 0.2 GM, demonstrating their potential for CPL biological imaging.\n                  <\/jats:p>","author":[{"given":"Sen","family":"Wu","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yan","family":"Xu","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-0804-4860","authenticated-orcid":false,"given":"Dominic J.","family":"Black","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Aidan P.","family":"McKay","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5366-9168","authenticated-orcid":false,"given":"David B.","family":"Cordes","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0641-4218","authenticated-orcid":false,"given":"Robert","family":"Pal","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-7183-6022","authenticated-orcid":false,"given":"Eli","family":"Zysman-Colman","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"container-title":["Nature Communications"]},{"DOI":"10.1038\/s41467-026-74533-8","title":["Efficient dissociation of ultra-high-strength bamboo original fibers via deep eutectic solvent pretreatment for sustainable composite reinforcement"],"created":{"date-parts":[[2026,9,15]],"date-time":"2026-09-15T08:08:29Z","timestamp":1789459709000},"published":{"date-parts":[[2026,9,15]]},"type":"journal-article","author":[{"given":"Ziliang","family":"Dai","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-8328-4648","authenticated-orcid":false,"given":"Lili","f