# ─── 孟德尔随机化分析服务配置 ───────────────────────────────────────

# ── LLM 配置（DeepSeek V4）──────────────────────────────────────────
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ── 外部数据源 ───────────────────────────────────────────────────────
# OpenGWAS API Token（用于在线 GWAS 数据检索）
# 申请：https://gwas.mrcieu.ac.uk/
OPENGWAS_JWT=

# PubMed API（用于文献搜索，免费但需邮箱）
PUBMED_EMAIL=

# UMLS API Key（用于同义词扩展，可选）
# 申请：https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=

# ── Java WebSocket 后端 ──────────────────────────────────────────────
# JAVA_WS_URL=ws://192.168.20.252:2066/ws/ws
# JAVA_TOKEN_URL=http://192.168.20.252:2066/api-evimed/ai-agent/token?clientType=mendelian-randomization

# 生产环境（取消注释切换）
JAVA_WS_URL=wss://evidence-factory.evimed.com/ws/ws
JAVA_TOKEN_URL=https://evidence-factory.evimed.com/api-evimed/ai-agent/token?clientType=mendelian-randomization

# ── OSS 对象存储 ──────────────────────────────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=project-beijing-a4hznzutlh
OSS_PUBLIC_BASE_URL=https://image.evimed.com/oss

# ── 服务运行参数 ──────────────────────────────────────────────────────
# 服务端口（uvicorn 启动时使用）
SERVICE_PORT=8003

# 是否在分析完成后清理本地临时文件（true/false）
CLEANUP_LOCAL_REPORT=true

# 最大并发会话数
MAX_CONCURRENT_SESSIONS=8
