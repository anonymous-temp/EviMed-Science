# LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=8192
LLM_MAX_TOKENS_PLANNING=4096
LLM_MAX_TOKENS_SCREENING=8192
LLM_MAX_TOKENS_EXTRACTION=16384
LLM_MAX_TOKENS_WRITING=32768
LLM_MAX_TOKENS_GRADE=8192
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=5
LLM_RETRY_MAX_WAIT_SECONDS=16
LLM_JSON_REPAIR_RETRIES=1
LLM_CONNECT_TIMEOUT_SECONDS=8
LLM_READ_TIMEOUT_SECONDS=120
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=8
LLM_USE_RESPONSES_API=0
LLM_ENABLE_SEARCH=0
LLM_FORCE_SEARCH=0
LLM_ENABLE_THINKING=
LLM_STREAM=0
LLM_SEARCH_STRATEGY=
# Optional cost estimate overrides used in llm_usage_manifest.json.
# Values are USD per 1M tokens; leave blank to use built-in estimates where available.
LLM_PRICE_INPUT_PER_1M_USD=
LLM_PRICE_OUTPUT_PER_1M_USD=
LLM_PRICE_SOURCE=

# Optional DashScope / BaiLian aliases (leave empty unless using DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-plus
DASHSCOPE_USE_RESPONSES_API=0
DASHSCOPE_ENABLE_SEARCH=0
DASHSCOPE_STREAM=1

# PubMed / NCBI
# Use a real contact email to comply with NCBI E-utilities policy.
PUBMED_EMAIL=
PUBMED_API_KEY=

# Internal literature database
INTERNAL_DB_URL=https://www.evimed.com/api-evimed/FineScreenController/interface/paper
EVIMED_EVIDENCE_URL=https://www.evimed.com/api-evimed/medicine-api/ai-api/search/api/evidence
EVIMED_API_KEY=
EVIMED_EVIDENCE_MAX_REFERENCES=12

# Optional post-write manuscript polish
MANUSCRIPT_POLISH_ENABLED=0
MANUSCRIPT_POLISH_USE_LLM=1
# targeted = only LLM-rewrite chunks with style issues; all = deep rewrite every polishable chunk
MANUSCRIPT_POLISH_REWRITE_SCOPE=targeted
MANUSCRIPT_POLISH_MAX_LLM_CHUNKS=6
# Optional review-only grammar/style proofreader. Use a self-hosted LanguageTool server.
MANUSCRIPT_POLISH_PROOFREADER=
LANGUAGETOOL_URL=
LANGUAGETOOL_TIMEOUT_SECONDS=8

# PDF parsing
MINERU_TOKEN=

# Pipeline controls
MAX_SEARCH_RESULTS=200
TOP_K_PAPERS=30
MAX_WORKERS=4
TA_BATCH_SIZE=50
BATCH_SCREENING_THRESHOLD=200
OUTPUT_DIR=output

# Optional Sci-Hub fallback
SCIHUB_BASE_URL=https://sci-hub.ren

# WebSocket service / external storage integration
MONGO_URI=
JAVA_API_BASE=https://evidence-factory.evimed.com/api-evimed
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
