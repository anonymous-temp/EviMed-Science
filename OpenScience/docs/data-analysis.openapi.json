                }
              }
            }
          },
          "403": {
            "description": "Missing scope, project grant or source grant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No resource visible to this account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Busy analysis, conflicting request ID or changed preserved bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Input or artifact exceeds the configured byte limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request or execution limit reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service disabled, under maintenance or unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "An account API key with analysis.read and/or analysis.write. Never a DeepSeek provider key. X-Subject is not supported."
      }
    },
    "schemas": {
      "CreateAnalysis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "name",
          "requestId"
        ]
      },
      "TurnRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "question",
          "requestId"
        ]
      },
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "filename"
        ],
        "oneOf": [
          {
            "required": [
              "base64"
            ]
          },
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "sourceId"
            ]
          }
        ],
        "description": "Exactly one source is required. URL input snapshots the returned bytes; it does not let a model fetch the source independently. Configured sources bind an exact endpoint and account grant on the server."
      },
      "Envelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "error",
          "requestId"
        ]
      },
      "InputReceipt": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "sha256",
          "bytes",
          "path",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "description": "Workspace-relative source copy; not a download grant."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "provenance": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "upload",
                  "url",
                  "configured-source"
                ]
              },
              "acquiredAt": {
                "type": "string",
                "format": "date-time"
              },
              "origin": {
                "type": "string"
              },
              "pathname": {
                "type": "string"
              },
              "sourceId": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "acquiredAt"
            ]
          }
        }
      },
      "Analysis": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "name",
          "requestId",
          "phase",
          "inputs",
          "turnIds",
          "sessionId",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "phase": {
            "enum": [
              "creating",
              "ready"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputReceipt"
            },
            "maxItems": 64
          },
          "turnIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 128
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": [
              "object",
              "null"
            ],
            "description": "A durable input/turn reservation. Poll the named turn before requesting another writer."
          }
        }
      },
      "Notice": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "path": {
            "type": "string"
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "role",
          "mediaType",
          "bytes",
          "sha256",
          "downloadUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string"
          },
          "role": {
            "enum": [
              "table",
              "figure",
              "report",
              "code",
              "data"
            ]
          },
          "mediaType": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verification": {
            "enum": [
              "verified",
              "unverified"
            ],
            "description": "Existing platform delivery-check label; not independent statistical validation, external validity or clinical certification."
          },
          "downloadUrl": {
            "type": "string",
            "description": "Same-origin API path. Send the account key to this path; never a provider credential."
          }
        }
      },
      "Result": {
        "type": "object",
        "required": [
          "summary",
          "structuredResults",
          "artifacts",
          "notices",
          "frozenAt"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "maxLength": 8000
          },
          "primaryOutput": {
            "type": [
              "object",
              "null"
            ],
            "description": "The coherent output bundle selected for summary and structuredResults: one explicitly presented bundle first, otherwise one outermost bundle. Discovery of nested copies cannot override it. Multiple explicit or unresolved outermost bundles return null with a notice.",
            "properties": {
              "directory": {
                "type": "string"
              },
              "manifestPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resultsPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reportPath": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "structuredResults": {
            "type": [
              "object",
              "null"
            ],
            "description": "Executed analysis JSON, when available. Its method-specific fields are open; missing/invalid content is null with a notice.",
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "analyses": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 64
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Artifact"
            },
            "maxItems": 64
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            },
            "maxItems": 128
          },
          "frozenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Turn": {
        "type": "object",
        "required": [
          "id",
          "analysisId",
          "status",
          "runId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "analysisId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "status": {
            "type": "string",
            "description": "Run lifecycle status, or dispatch_unknown when acceptance cannot be established. A succeeded run does not imply every scientific claim is verified."
          },
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "errorCode": {
            "type": "string"
          },
          "dispatchStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/Result"
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notice"
            }
          }
        }
      }
    }
  }
}
