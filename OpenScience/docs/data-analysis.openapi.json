{
  "openapi": "3.1.0",
  "info": {
    "title": "EviMed Data Analysis API",
    "version": "1.0.0",
    "description": "Authenticated asynchronous scientific analysis on DeepSeek and DSH. Each analysis owns a separate project/runtime. Follow-up turns share its state and serialize. Results are frozen per turn; partial outputs and notices remain visible."
  },
  "servers": [
    {
      "url": "/api/data-analysis/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
