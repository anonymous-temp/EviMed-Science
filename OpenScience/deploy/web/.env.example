# Copy to deploy/web/.env before running docker compose.

NODE_ENV=production
# `controlled-pilot` is the honest default and does not claim public SaaS
# readiness. Use `individual-saas` only with both the OIDC and SaaS Compose
# overlays after every readiness boundary passes.
OPEN_SCIENCE_DEPLOYMENT_PROFILE=controlled-pilot
# Surfaces this deployment has chosen not to configure, named one at a time
# (comma separated readiness requirement ids). An undeclared miss still fails,
# and what is declared comes back in the readiness body next to what was
# validated, so nothing is hidden -- the point is that a probe red for four
# reasons, three of them permanent by decision, is one nobody reads.
# OPEN_SCIENCE_SAAS_PROFILE_UNCONFIGURED=oidc-identity,audited-science-connectors,external-recovery
OPEN_SCIENCE_PUBLIC_URL=https://science.example.com
# Host-only API diagnostic port. The production Compose file fixes its bind
# address to 127.0.0.1 so public traffic cannot bypass Caddy/TLS.
OPEN_SCIENCE_API_PORT=8787
# Caddy TLS hostname. This must exactly match OPEN_SCIENCE_PUBLIC_URL's host.
OPEN_SCIENCE_DOMAIN=science.example.com
OPEN_SCIENCE_CADDY_VERSION=2.11.4-alpine
# Host-only preflight controls; these are not application runtime settings.
OPEN_SCIENCE_PREFLIGHT_MONITORING=true
OPEN_SCIENCE_PREFLIGHT_ALERT_DELIVERY=true
OPEN_SCIENCE_PREFLIGHT_OBJECT_STORAGE=true
OPEN_SCIENCE_PREFLIGHT_MIN_FREE_BYTES=10737418240
# Immutable release identity. Populate these from the release pipeline, then
# build both images before running `pnpm release:manifest`.
OPEN_SCIENCE_APP_VERSION=0.1.3
OPEN_SCIENCE_RELEASE_ID=replace-with-release-id
OPEN_SCIENCE_SOURCE_REVISION=replace-with-the-40-character-source-revision
OPEN_SCIENCE_BUILD_CREATED=replace-with-rfc3339-build-time
OPEN_SCIENCE_WEB_CONTAINER_IMAGE=open-science-web:0.1.3
# Optional build-time package sources. Keep the official defaults unless the
# deployment region has a faster trusted mirror; they apply to every image the
# stack builds, which `pnpm audit:hosted-compliance` verifies.
OPEN_SCIENCE_APK_MIRROR=https://dl-cdn.alpinelinux.org/alpine
OPEN_SCIENCE_NPM_REGISTRY=https://registry.npmjs.org
OPEN_SCIENCE_APT_MIRROR=http://deb.debian.org/debian
OPEN_SCIENCE_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
OPEN_SCIENCE_PIP_INDEX_URL=https://pypi.org/simple
OPEN_SCIENCE_GITHUB_DOWNLOAD_PREFIX=
OPEN_SCIENCE_GOPROXY=https://goproxy.cn,direct
OPEN_SCIENCE_CRAN_MIRROR=https://cloud.r-project.org
OPEN_SCIENCE_RELEASE_MANIFEST_HOST_FILE=./release-manifest.json
# Stable Docker volume name shared by the API, runtime, and optional kernel
# containers. Changing it selects a different application data volume. Runtime
# subpath mounts require Docker Engine 26 or newer.
OPEN_SCIENCE_DATA_VOLUME=open-science-data
# Numeric group owner of the host Docker socket. On the Linux deployment host,
# set this to the exact output of: stat -c '%g' /var/run/docker.sock
# Host preflight rejects a stale or mismatched value. This lets the unexposed
# Runtime Controller keep all Linux capabilities dropped while accessing only
# its explicitly mounted Docker socket.
OPEN_SCIENCE_DOCKER_SOCKET_GID=replace-with-docker-socket-gid
# Authentication mode: `local` for a controlled single-node pilot, or `oidc`
# with the docker-compose.oidc.yml overlay for an external identity provider.
# Local mode uses docker-compose.local-auth.yml. Generate its owner-only Docker
# secret source with `pnpm configure:local-auth`; do not put the password here.
OPEN_SCIENCE_AUTH_MODE=local
# Whether anyone may create an account on this deployment. Off by default:
# being open is a decision the operator makes, not one a build carries. Only
# has an effect with OPEN_SCIENCE_AUTH_MODE=local — under OIDC the identity
# provider owns accounts, and the route answers 404 there.
OPEN_SCIENCE_SELF_REGISTRATION_ENABLED=0
# Per-account spend caps, in the price list's currency (CNY). 0 = no cap.
# Checked when a run is dispatched, never mid-run: stopping a run halfway
# spends everything it cost and delivers nothing.
OPEN_SCIENCE_USER_DAILY_SPEND_LIMIT=0
OPEN_SCIENCE_USER_WEEKLY_SPEND_LIMIT=0
OPEN_SCIENCE_BOOTSTRAP_USER=admin
OPEN_SCIENCE_BOOTSTRAP_PASSWORD=
OPEN_SCIENCE_BOOTSTRAP_PASSWORD_FILE=./secrets/bootstrap-password.txt
OPEN_SCIENCE_SESSION_TTL_MS=604800000

# Shared production control-plane state and Memos integration. Run
# `pnpm configure:production-state` before Compose; it creates owner-only
# password/DSN files without placing credentials in this env file.
OPEN_SCIENCE_PRODUCTION_STATE_SECRETS_DIR=./secrets
OPEN_SCIENCE_POSTGRES_PASSWORD_HOST_FILE=./secrets/postgres-password.txt
OPEN_SCIENCE_DATABASE_URL_HOST_FILE=./secrets/database-url.txt
OPEN_SCIENCE_MEMOS_DSN_HOST_FILE=./secrets/memos-dsn.txt
OPEN_SCIENCE_MEMOS_ADMIN_PASSWORD_HOST_FILE=./secrets/memos-admin-password.txt
OPEN_SCIENCE_MEMOS_ADMIN_USER=evimed-memory
# Optional dedicated browser-visible Memos origin. EviMed consumes Memos over
# the private Compose network and does not publish a /memos reverse proxy.
# Leave empty unless the operator exposes Memos through a separately reviewed
# HTTPS origin; the internal integration remains fully functional when empty.
OPEN_SCIENCE_MEMOS_PUBLIC_URL=
OPEN_SCIENCE_MEMOS_CONTAINER_IMAGE=evimed-memos:0.31.1-evimed
OPEN_SCIENCE_MEMORY_EXTRACTION_ENABLED=true
OPEN_SCIENCE_MEMORY_EXTRACTION_TIMEOUT_MS=30000

# OIDC Authorization Code + PKCE. Keep the two secrets out of this file. Set
# the non-secret values below, provide OPEN_SCIENCE_OIDC_CLIENT_SECRET only to
# `pnpm configure:oidc`, and start Compose with docker-compose.oidc.yml so the
# generated owner-only files are mounted as Docker secrets.
OPEN_SCIENCE_OIDC_ISSUER=
OPEN_SCIENCE_OIDC_CLIENT_ID=
OPEN_SCIENCE_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OPEN_SCIENCE_OIDC_SCOPES=openid profile email
OPEN_SCIENCE_OIDC_LABEL=Organization SSO
# Optional admission controls. When email domains are configured, the ID token
# must contain a verified email in one of these exact domains.
OPEN_SCIENCE_OIDC_ALLOWED_GROUPS=
OPEN_SCIENCE_OIDC_GROUP_CLAIM=groups
OPEN_SCIENCE_OIDC_ALLOWED_EMAIL_DOMAINS=
OPEN_SCIENCE_OIDC_TIMEOUT_MS=10000
OPEN_SCIENCE_OIDC_FLOW_TTL_MS=600000
OPEN_SCIENCE_OIDC_SECRETS_DIR=./secrets
# Required in production when the monitoring overlay is not used. Replace with
# at least 32 random bytes and give only the monitoring scraper access to it.
# Do not set both TOKEN and TOKEN_FILE. The monitoring overlay uses a Docker
# secret file generated by `pnpm configure:monitoring` instead.
OPEN_SCIENCE_OPERATOR_METRICS_TOKEN=replace-with-a-long-random-scrape-token
OPEN_SCIENCE_OPERATOR_METRICS_TOKEN_FILE=

# Optional bundled monitoring profile. Consoles bind to loopback only.
OPEN_SCIENCE_MONITORING_SECRETS_DIR=./secrets
OPEN_SCIENCE_PROMETHEUS_VERSION=v3.13.0
OPEN_SCIENCE_ALERTMANAGER_VERSION=v0.33.1
OPEN_SCIENCE_BLACKBOX_EXPORTER_VERSION=v0.28.0
OPEN_SCIENCE_GRAFANA_VERSION=13.1.0
OPEN_SCIENCE_PROMETHEUS_RETENTION_TIME=30d
OPEN_SCIENCE_PROMETHEUS_RETENTION_SIZE=10GB
OPEN_SCIENCE_PROMETHEUS_PORT=9090
OPEN_SCIENCE_ALERTMANAGER_PORT=9093
OPEN_SCIENCE_GRAFANA_PORT=3000
OPEN_SCIENCE_GRAFANA_ADMIN_USER=admin
# Supply these only to the configure command's process environment; do not
# persist them in this Compose .env file:
# OPEN_SCIENCE_GRAFANA_ADMIN_PASSWORD
# OPEN_SCIENCE_ALERT_WEBHOOK_URL

# Backup and restore readiness. For production, choose either:
# - local: use docker-compose.backup.yml with the `backup` profile
# - external: platform/object-store snapshots managed outside this container
OPEN_SCIENCE_BACKUP_MODE=local
OPEN_SCIENCE_BACKUP_DIR=/backups
OPEN_SCIENCE_BACKUP_RETENTION_DAYS=30
OPEN_SCIENCE_BACKUP_ENCRYPTION_ACK=false
OPEN_SCIENCE_BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase.txt
OPEN_SCIENCE_BACKUP_EXTERNAL_ACK=false
# Set true only after scheduled restore drills are configured and owned.
OPEN_SCIENCE_RESTORE_DRILL_ACK=false
OPEN_SCIENCE_BACKUP_INTERVAL_SECONDS=86400
OPEN_SCIENCE_BACKUP_HEALTH_GRACE_SECONDS=1800
OPEN_SCIENCE_BACKUP_RETRY_SECONDS=300
OPEN_SCIENCE_BACKUP_MAX_FAILURES=3
OPEN_SCIENCE_BACKUP_RESTORE_DRILL_EVERY=1
OPEN_SCIENCE_BACKUP_TMPFS_SIZE=2g
OPEN_SCIENCE_WEB_TMPFS_SIZE=128m
# Encrypted off-host copy used by scripts/ops/backup-data.sh. The production
# preflight above requires this URI and verifies write, read-back, integrity,
# and delete access. The target host needs the AWS CLI or a compatible executable
# selected with OPEN_SCIENCE_OBJECT_BACKUP_CLI. Keep AWS
# credentials out of this file; use the CLI credential chain, workload identity,
# or an owner-only process environment.
OPEN_SCIENCE_OBJECT_BACKUP_URI=
OPEN_SCIENCE_OBJECT_BACKUP_CLI=aws
OPEN_SCIENCE_OBJECT_BACKUP_SSE=AES256

# Production runtime: the service-hosted agent kernel, one Docker container per
# project. OPEN_SCIENCE_OPENCODE_BIN and OPEN_SCIENCE_OPENCODE_VERSION were
# removed with the second kernel; a deployment that still exports either is
# refused at startup by name rather than starting with it ignored.
#
# The kernel pin. These are the build arguments of the runtime image and the
# versions the release manifest records for it, so a deployment that moves one
# and not the others is refused as release_manifest_mismatch rather than
# launching a kernel nobody signed off.
OPEN_SCIENCE_DSH_VERSION=0.1.2-rc.1
OPEN_SCIENCE_DSH_CORDIS_VERSION=4.0.2
OPEN_SCIENCE_SOCKET_VERSION=0.1.0
OPEN_SCIENCE_NODE_VERSION=22.22.0
OPEN_SCIENCE_PNPM_VERSION=11.7.0
OPEN_SCIENCE_UV_VERSION=0.11.26
# These digests bind the exact official release archives and license texts used
# by the runtime image. Update the version and all matching digests together.
OPEN_SCIENCE_UV_SHA256_AMD64=6426a73c3837e6e2483ee344cbc00f36394d179afcba6183cb77437e67db4af0
OPEN_SCIENCE_UV_SHA256_ARM64=befa1a59c91e96eb601b0fd9a97c03dd666f17baba644b2b4db9c59a767e387e
OPEN_SCIENCE_UV_LICENSE_MIT_SHA256=860e3d7a86b84e6a7012c7a635fc64df475cebc6cce34dfeb73a5982ec58176c
OPEN_SCIENCE_RUNTIME_MODE=kernel
OPEN_SCIENCE_RUNTIME_SANDBOX_MODE=docker
# Production Compose fixes this to the isolated Unix-socket controller. The API
# container must not receive /var/run/docker.sock.
OPEN_SCIENCE_RUNTIME_CONTROLLER_TIMEOUT_MS=30000
OPEN_SCIENCE_RUNTIME_CONTROLLER_POLL_MS=500
OPEN_SCIENCE_RUNTIME_CONTAINER_IMAGE=open-science-runtime:dsh-0.1.2-rc.1-uv-0.11.26
OPEN_SCIENCE_RUNTIME_REQUIRE_IMAGE_LOCAL=true
OPEN_SCIENCE_RUNTIME_TRANSPORT=unix
OPEN_SCIENCE_RUNTIME_NETWORK_MODE=open-science-runtime-internal
OPEN_SCIENCE_RUNTIME_INTERNAL_NETWORK_NAME=open-science-runtime-internal
OPEN_SCIENCE_ALLOW_RUNTIME_NETWORK_EGRESS=false
# The named internal network reaches only the Web model and official-host
# public-source gateways. Keep arbitrary runtime egress disabled; other
# networks still require explicit opt-in.
OPEN_SCIENCE_RUNTIME_NETWORK_EGRESS_POLICY_ACK=false
OPEN_SCIENCE_RUNTIME_CPU_LIMIT=2
OPEN_SCIENCE_RUNTIME_MEMORY_LIMIT=4g
OPEN_SCIENCE_RUNTIME_PIDS_LIMIT=256
OPEN_SCIENCE_RUNTIME_READ_ONLY_ROOT=true
OPEN_SCIENCE_RUNTIME_TMPFS=/tmp:rw,nosuid,nodev,size=64m
# Defaults to the first-party core skills copied into the Web service image.
# Set to an empty value to disable managed runtime skill deployment.
OPEN_SCIENCE_RUNTIME_SKILL_DIRS=runtime/skills/core,runtime/skills/external/ai4s-skills,runtime/skills/curated-scientific,runtime/skills/office
OPEN_SCIENCE_EVIMED_MCP_SOURCE_DIR=runtime/mcp/evimed-research
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET=
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET_FILE=
OPEN_SCIENCE_DEEPSEEK_PROVIDER_ENABLED=true
OPEN_SCIENCE_REQUIRE_ALL_SPECIALIST_ADAPTERS=true
# Prefer owner-readable mounted secret files. Do not put real provider keys in
# this example, runtime config, browser settings, or project workspaces.
OPEN_SCIENCE_DEEPSEEK_API_KEY_HOST_FILE=./secrets/deepseek-api-key.txt
OPEN_SCIENCE_DEEPSEEK_API_KEY_FILE=./secrets/deepseek-api-key.txt
OPEN_SCIENCE_MODEL_GATEWAY_SIGNING_SECRET_HOST_FILE=./secrets/model-gateway-signing-key.txt
OPEN_SCIENCE_EVIMED_API_KEY_HOST_FILE=./secrets/evimed-api-key.txt
OPEN_SCIENCE_EVIMED_API_KEY_FILE=./secrets/evimed-api-key.txt
# Gated evidence connectors (Semantic Scholar, CORE, Unpaywall, UMLS, OMIM,
# Addgene, BioGRID, OpenGWAS) use optional server-managed keys injected through
# the public-source gateway; Semantic Scholar and Unpaywall also work keyless.
# Audit each connector's credential posture (no network, no secret values):
#   node scripts/ops/check-evidence-connectors.mjs
OPEN_SCIENCE_MATERIALS_PROJECT_API_KEY_HOST_FILE=./secrets/materials-project-api-key.txt
OPEN_SCIENCE_REQUIRE_MATERIALS_PROJECT=true
OPEN_SCIENCE_MATERIALS_PROJECT_API_KEY_FILE=./secrets/materials-project-api-key.txt
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET_HOST_FILE=./secrets/evimed-workload-signing-key.txt
OPEN_SCIENCE_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPEN_SCIENCE_DEEPSEEK_MODEL=deepseek-v4-pro
# LLM-augmented open-domain routing. On by default; the LLM classifier only runs
# after the regex router finds no match, never overrides a deterministic
# clinical/specialty route, and fails safe to open-domain on any error. Set to
# false to fall back to regex-only routing.
OPEN_SCIENCE_LLM_ROUTING_ENABLED=true
OPEN_SCIENCE_LLM_ROUTING_CONFIDENCE_THRESHOLD=0.75
OPEN_SCIENCE_MODEL_GATEWAY_INTERNAL_URL=http://open-science-web:8787/internal/model/v1
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_INTERNAL_URL=http://open-science-web:8787/internal/sources/v1/fetch
# The GEO probe host: a desktop running five consumer LLM front-ends with tabs
# already signed in, reachable over HTTP. Empty leaves `geo_visibility_probe`
# switched off, which is what a deployment that cannot measure should report --
# an estimate presented as a measurement is the failure that tool exists to
# avoid. Plaintext is opt-in because the questions and the answers travel
# unencrypted, and the signing secret is optional because a probe host that
# does not verify one is the common case.
OPEN_SCIENCE_GEO_PROBE_URL=
OPEN_SCIENCE_GEO_PROBE_ALLOW_PLAINTEXT=
OPEN_SCIENCE_GEO_PROBE_TIMEOUT_MS=360000
# Serve the kernel's own browser application as this deployment's session
# surface. Off by default: an authenticated browser then reaches that project's
# kernel surface, which is the boundary the retired pass-through route existed
# to hold, and `@evimed/domain`'s runtime-UI deny list is what bounds it.
#
# It gets an origin of its own rather than a path, because it builds every URL
# it fetches from `location.origin` -- its plugin bundles are `/plugins/...`
# and its method calls are `/api/<method>`, both absolute. Behind a path prefix
# those reach the control plane, which answers them with its own document: the
# page then dies at boot while every request reads 200.
#
# PORT is what the container listens on; the host publishes it and PUBLIC_ORIGIN
# is the address the page frames. Same host as the API, different port: a
# different origin (so the frame is isolated) on the same site (so the session
# cookie is still sent). Readiness refuses production with either one missing.
OPEN_SCIENCE_RUNTIME_UI_PROXY_ENABLED=
OPEN_SCIENCE_RUNTIME_UI_PORT=8788
OPEN_SCIENCE_RUNTIME_UI_HOST_PORT=8788
OPEN_SCIENCE_RUNTIME_UI_PUBLIC_ORIGIN=
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_TIMEOUT_MS=60000
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_MAX_RESPONSE_BYTES=16777216
OPEN_SCIENCE_MODEL_GATEWAY_TIMEOUT_MS=300000
OPEN_SCIENCE_MODEL_GATEWAY_MAX_BODY_BYTES=2097152
OPEN_SCIENCE_MODEL_GATEWAY_MAX_RESPONSE_BYTES=33554432
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_HOST_FILE=./secrets/deepseek-release-receipt.json
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_FILE=./secrets/deepseek-release-receipt.json
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_ID=dsrg_replace_with_operator_gate_id
OPEN_SCIENCE_DEEPSEEK_CONFIG_REVISION=replace-with-reviewed-gateway-config-revision
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_MAX_AGE_MS=86400000
EVIMED_BIOMEDICAL_SOURCE_SEARCH_URL=
EVIMED_LITERATURE_SEARCH_URL=
EVIMED_GUIDELINE_SEARCH_URL=
EVIMED_CLINICAL_TRIAL_SEARCH_URL=
EVIMED_PATENT_SEARCH_URL=
# Base tool names the research MCP must not offer at all, comma-separated.
# An empty adapter URL above means "should work, is not configured" and fails a
# call with `adapter_unconfigured`; a name here means "this deployment does not
# do that", and the tool never reaches the model's catalogue.
EVIMED_DISABLED_TOOLS=
EVIMED_PHARMACY_REFERENCE_SEARCH_URL=
EVIMED_DRUG_LABEL_SEARCH_URL=
EVIMED_ADR_CASE_QUERY_URL=
EVIMED_ADR_SIGNAL_ANALYSIS_URL=
EVIMED_OFFLABEL_EVIDENCE_PACKET_URL=
EVIMED_COMPREHENSIVE_DRUG_EVALUATION_URL=
EVIMED_DRUG_SELECTION_EVALUATION_URL=
EVIMED_META_ANALYSIS_URL=http://evimed-meta-agent:8024/api/v1/evimed/meta-analysis
EVIMED_MR_ANALYSIS_URL=
EVIMED_BIBLIOMETRIC_ANALYSIS_URL=
EVIMED_RESEARCH_TOPIC_SELECTION_URL=
EVIMED_PEER_REVIEW_URL=
EVIMED_DRUG_SAFETY_ANALYSIS_URL=
# Optional: contact email enabling the Unpaywall connector's keyless public tier
# when no server-managed credential is injected. Empty keeps it fail-closed.
# EVIMED_UNPAYWALL_EMAIL=
EVIMED_META_AGENT_IMAGE=evimed-meta-agent:0.9.0
EVIMED_META_AGENT_VERSION=0.9.0

# Optional: run the OpenCode container as a non-root UID/GID after verifying
# the mounted data volume is writable by that identity.
# OPEN_SCIENCE_RUNTIME_CONTAINER_USER=1000:1000

# Keep host-level escape hatches disabled for hosted deployments.
OPEN_SCIENCE_ALLOW_RUNTIME_HOST_NETWORK=false
OPEN_SCIENCE_ALLOW_UNSANDBOXED_RUNTIME=false
OPEN_SCIENCE_ALLOW_HOST_SHELL=false
OPEN_SCIENCE_ALLOW_DIRECT_SHELL=false
OPEN_SCIENCE_ALLOW_PERSISTENT_APPROVALS=false
OPEN_SCIENCE_ALLOW_FULL_APPROVAL=false

# Optional server-side Python kernel execution. Disabled by default; if enabled
# in hosted deployments, keep it on the Docker sandbox and the same reviewed
# runtime image/resource limits.
OPEN_SCIENCE_ENABLE_KERNEL=false
OPEN_SCIENCE_KERNEL_SANDBOX_MODE=docker
OPEN_SCIENCE_ALLOW_UNSANDBOXED_KERNEL=false

# Capacity and rate limits.
OPEN_SCIENCE_MAX_PROJECT_BYTES=1073741824
OPEN_SCIENCE_MAX_JSON_BYTES=12582912
OPEN_SCIENCE_MAX_FILE_BYTES=52428800
# Must be at least ceil(OPEN_SCIENCE_MAX_FILE_BYTES * 1.4) + 8192 for browser/base64 uploads.
OPEN_SCIENCE_PROXY_MAX_BODY_SIZE=73408512
OPEN_SCIENCE_MAX_WORKSPACE_SCAN_ENTRIES=10000
OPEN_SCIENCE_MAX_ARCHIVE_ENTRIES=10000
OPEN_SCIENCE_MAX_ARCHIVE_BYTES=1073741824
OPEN_SCIENCE_MAX_PROJECT_USAGE_SCAN_ENTRIES=10000
OPEN_SCIENCE_MAX_LOG_READ_BYTES=1048576
OPEN_SCIENCE_MAX_LOG_FILE_BYTES=10485760
OPEN_SCIENCE_KERNEL_MAX_OUTPUT_BYTES=1048576
OPEN_SCIENCE_KERNEL_TIMEOUT_MS=10000
OPEN_SCIENCE_MAX_CONCURRENT_COMMANDS=8
OPEN_SCIENCE_MAX_CONCURRENT_KERNELS=2
OPEN_SCIENCE_MAX_CONCURRENT_KERNELS_PER_USER=1
OPEN_SCIENCE_MAX_CONCURRENT_TASKS=2
OPEN_SCIENCE_MAX_CONCURRENT_TASKS_PER_PROJECT=1
OPEN_SCIENCE_MAX_QUEUED_TASKS=100
OPEN_SCIENCE_MAX_QUEUED_TASKS_PER_PROJECT=25
OPEN_SCIENCE_COMMAND_TIMEOUT_MS=120000
OPEN_SCIENCE_RUNTIME_PROXY_CONNECT_TIMEOUT_MS=90000
OPEN_SCIENCE_RUNTIME_PROXY_REQUEST_TIMEOUT_MS=120000
OPEN_SCIENCE_RUNTIME_IDLE_TIMEOUT_MS=1800000
OPEN_SCIENCE_RUNTIME_QUOTA_CHECK_INTERVAL_MS=30000
OPEN_SCIENCE_MAX_RUNTIME_PROXY_CONNECTIONS=64
OPEN_SCIENCE_MAX_RUNTIME_PROXY_CONNECTIONS_PER_PROJECT=8
# These limits are enforced independently by both the API and Runtime Controller.
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES=8
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES_PER_USER=4
OPEN_SCIENCE_RATE_LIMIT_MAX_REQUESTS=600
OPEN_SCIENCE_AUTH_RATE_LIMIT_MAX_REQUESTS=20
OPEN_SCIENCE_COMMAND_RATE_LIMIT_MAX_REQUESTS=120
# Required by the bundled production Caddy boundary. Caddy overwrites
# X-Forwarded-For before the API uses its validated IP for rate limiting.
OPEN_SCIENCE_TRUST_PROXY=true

# Optional comma-separated extra frontend origins when API and frontend differ.
OPEN_SCIENCE_CORS_ORIGINS=

# Local smoke-test only:
# NODE_ENV=development
# OPEN_SCIENCE_PUBLIC_URL=http://localhost:8787
# OPEN_SCIENCE_RUNTIME_MODE=mock
# OPEN_SCIENCE_ALLOW_MOCK_RUNTIME=true
