# Copy to deploy/web/.env before running docker compose.

NODE_ENV=production
# `controlled-pilot` is the honest default and does not claim public SaaS
# readiness. Use `individual-saas` only with both the OIDC and SaaS Compose
# overlays after every readiness boundary passes.
OPEN_SCIENCE_DEPLOYMENT_PROFILE=controlled-pilot
# Surfaces this deployment has chosen not to configure, named one at a time
# (comma separated readiness requirement ids). An undeclared miss still fails,
# and what is declared comes back in the readiness body next to what was
# validated, so nothing is hidden -- the point is that a probe red for four
# reasons, three of them permanent by decision, is one nobody reads.
# OPEN_SCIENCE_SAAS_PROFILE_UNCONFIGURED=oidc-identity,audited-science-connectors,external-recovery
OPEN_SCIENCE_PUBLIC_URL=https://science.example.com
# Host-only API diagnostic port. The production Compose file fixes its bind
# address to 127.0.0.1 so public traffic cannot bypass Caddy/TLS.
OPEN_SCIENCE_API_PORT=8787
# Caddy TLS hostname. This must exactly match OPEN_SCIENCE_PUBLIC_URL's host.
OPEN_SCIENCE_DOMAIN=science.example.com
OPEN_SCIENCE_CADDY_VERSION=2.11.4-alpine
# Host-only preflight controls; these are not application runtime settings.
OPEN_SCIENCE_PREFLIGHT_MONITORING=true
OPEN_SCIENCE_PREFLIGHT_ALERT_DELIVERY=true
OPEN_SCIENCE_PREFLIGHT_OBJECT_STORAGE=true
OPEN_SCIENCE_PREFLIGHT_MIN_FREE_BYTES=10737418240
# Immutable release identity. Populate these from the release pipeline, then
# build both images before running `pnpm release:manifest`.
OPEN_SCIENCE_APP_VERSION=0.1.3
OPEN_SCIENCE_RELEASE_ID=replace-with-release-id
OPEN_SCIENCE_SOURCE_REVISION=replace-with-the-40-character-source-revision
OPEN_SCIENCE_BUILD_CREATED=replace-with-rfc3339-build-time
OPEN_SCIENCE_WEB_CONTAINER_IMAGE=open-science-web:0.1.3
# Optional build-time package sources. Keep the official defaults unless the
# deployment region has a faster trusted mirror; they apply to every image the
# stack builds, which `pnpm audit:hosted-compliance` verifies.
OPEN_SCIENCE_APK_MIRROR=https://dl-cdn.alpinelinux.org/alpine
OPEN_SCIENCE_NPM_REGISTRY=https://registry.npmjs.org
OPEN_SCIENCE_APT_MIRROR=http://deb.debian.org/debian
OPEN_SCIENCE_DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
OPEN_SCIENCE_PIP_INDEX_URL=https://pypi.org/simple
OPEN_SCIENCE_GITHUB_DOWNLOAD_PREFIX=
OPEN_SCIENCE_CRAN_MIRROR=https://cloud.r-project.org
OPEN_SCIENCE_RELEASE_MANIFEST_HOST_FILE=./release-manifest.json
# Stable Docker volume name shared by the API and runtime containers. Changing
# it selects a different application data volume. Runtime subpath mounts
# require Docker Engine 26 or newer.
OPEN_SCIENCE_DATA_VOLUME=open-science-data
# Numeric group owner of the host Docker socket. On the Linux deployment host,
# set this to the exact output of: stat -c '%g' /var/run/docker.sock
# Host preflight rejects a stale or mismatched value. This lets the unexposed
# Runtime Controller keep all Linux capabilities dropped while accessing only
# its explicitly mounted Docker socket.
OPEN_SCIENCE_DOCKER_SOCKET_GID=replace-with-docker-socket-gid
# Authentication mode: `local` for a controlled single-node pilot, or `oidc`
# with the docker-compose.oidc.yml overlay for an external identity provider.
# Local mode uses docker-compose.local-auth.yml. Generate its owner-only Docker
# secret source with `pnpm configure:local-auth`; do not put the password here.
OPEN_SCIENCE_AUTH_MODE=local
# Whether anyone may create an account on this deployment. Off by default:
# being open is a decision the operator makes, not one a build carries. Only
# has an effect with OPEN_SCIENCE_AUTH_MODE=local — under OIDC the identity
# provider owns accounts, and the route answers 404 there.
OPEN_SCIENCE_SELF_REGISTRATION_ENABLED=0
# Per-account spend caps, in the price list's currency (CNY). 0 = no cap.
# Checked when a run is dispatched, never mid-run: stopping a run halfway
# spends everything it cost and delivers nothing.
OPEN_SCIENCE_USER_DAILY_SPEND_LIMIT=0
OPEN_SCIENCE_USER_WEEKLY_SPEND_LIMIT=0
# A cap per interactive run, same currency; 0 = no cap. Unlike the two above it
# is checked on every model call, so a run that reaches it stops mid-way.
OPEN_SCIENCE_USER_RUN_SPEND_LIMIT=0
# How many projects one account may hold. Each carries its own storage quota
# and its own runtime, so this is what makes those two limits mean anything.
OPEN_SCIENCE_MAX_PROJECTS_PER_USER=20
OPEN_SCIENCE_BOOTSTRAP_USER=admin
OPEN_SCIENCE_BOOTSTRAP_PASSWORD=
OPEN_SCIENCE_BOOTSTRAP_PASSWORD_FILE=./secrets/bootstrap-password.txt
OPEN_SCIENCE_SESSION_TTL_MS=604800000

# Shared production control-plane state. Run `pnpm configure:production-state`
# before Compose; it creates owner-only password, DSN and recall-index files
# without placing credentials in this env file. Research memory and memory
# capsules live in this same PostgreSQL, so they need no store of their own.
OPEN_SCIENCE_PRODUCTION_STATE_SECRETS_DIR=./secrets
OPEN_SCIENCE_POSTGRES_PASSWORD_HOST_FILE=./secrets/postgres-password.txt
OPEN_SCIENCE_DATABASE_URL_HOST_FILE=./secrets/database-url.txt
OPEN_SCIENCE_MEMORY_EXTRACTION_ENABLED=true
OPEN_SCIENCE_MEMORY_EXTRACTION_TIMEOUT_MS=120000
OPEN_SCIENCE_MEMORY_ENABLED=true
# The account API for external agents (docs/AGENT_MEMORY_API.md). Off by default.
OPEN_SCIENCE_AGENT_MEMORY_API_ENABLED=false
OPEN_SCIENCE_MEMORY_EXTRACTION_EXCLUDED_PROJECT_PREFIXES=
# How long an inferred memory lives after it was last observed, in days (0 =
# never). Inferences take effect without a confirmation step, labelled as
# inferences; one that is not observed again fades after this many days.
OPEN_SCIENCE_MEMORY_INFERRED_TTL_DAYS=90
# Server-side repair rounds after the delivery gate. 0 delivers a package with
# what the gate found attached; a positive number sends it back that many times
# first (10 to 35 minutes each, measured).
OPEN_SCIENCE_GATE_REPAIR_ROUNDS=0

# OIDC Authorization Code + PKCE. Keep the two secrets out of this file. Set
# the non-secret values below, provide OPEN_SCIENCE_OIDC_CLIENT_SECRET only to
# `pnpm configure:oidc`, and start Compose with docker-compose.oidc.yml so the
# generated owner-only files are mounted as Docker secrets.
OPEN_SCIENCE_OIDC_ISSUER=
OPEN_SCIENCE_OIDC_CLIENT_ID=
OPEN_SCIENCE_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OPEN_SCIENCE_OIDC_SCOPES=openid profile email
OPEN_SCIENCE_OIDC_LABEL=Organization SSO
# Optional admission controls. When email domains are configured, the ID token
# must contain a verified email in one of these exact domains.
OPEN_SCIENCE_OIDC_ALLOWED_GROUPS=
OPEN_SCIENCE_OIDC_GROUP_CLAIM=groups
OPEN_SCIENCE_OIDC_ALLOWED_EMAIL_DOMAINS=
OPEN_SCIENCE_OIDC_TIMEOUT_MS=10000
OPEN_SCIENCE_OIDC_FLOW_TTL_MS=600000
OPEN_SCIENCE_OIDC_SECRETS_DIR=./secrets
# Required in production when the monitoring overlay is not used. Replace with
# at least 32 random bytes and give only the monitoring scraper access to it.
# Do not set both TOKEN and TOKEN_FILE. The monitoring overlay uses a Docker
# secret file generated by `pnpm configure:monitoring` instead.
OPEN_SCIENCE_OPERATOR_METRICS_TOKEN=replace-with-a-long-random-scrape-token
OPEN_SCIENCE_OPERATOR_METRICS_TOKEN_FILE=

# Optional bundled monitoring profile. Consoles bind to loopback only.
OPEN_SCIENCE_MONITORING_SECRETS_DIR=./secrets
OPEN_SCIENCE_PROMETHEUS_VERSION=v3.13.0
OPEN_SCIENCE_ALERTMANAGER_VERSION=v0.33.1
OPEN_SCIENCE_BLACKBOX_EXPORTER_VERSION=v0.28.0
OPEN_SCIENCE_GRAFANA_VERSION=13.1.0
OPEN_SCIENCE_PROMETHEUS_RETENTION_TIME=30d
OPEN_SCIENCE_PROMETHEUS_RETENTION_SIZE=10GB
OPEN_SCIENCE_PROMETHEUS_PORT=9090
OPEN_SCIENCE_ALERTMANAGER_PORT=9093
OPEN_SCIENCE_GRAFANA_PORT=3000
OPEN_SCIENCE_GRAFANA_ADMIN_USER=admin
# Supply these only to the configure command's process environment; do not
# persist them in this Compose .env file:
# OPEN_SCIENCE_GRAFANA_ADMIN_PASSWORD
# OPEN_SCIENCE_ALERT_WEBHOOK_URL

OPEN_SCIENCE_NODE_EXPORTER_VERSION=v1.10.2

# The public origin whose certificate `OpenScienceCertificateExpiringSoon`
# watches. Every other probe target is a compose service name reached over plain
# HTTP inside the network, where there is no certificate to measure; this is the
# one a browser is actually offered. Must be https — an http target reports no
# expiry at all, which reads as "the certificate is fine" forever. Optional:
# leave it unset on a deployment that terminates TLS somewhere this host cannot
# reach, and the probe simply has nothing to scrape.
#
# Commented for the same reason as the two above it, and it is a real rule
# rather than tidiness: this is read by `configure:monitoring` on the host,
# which writes monitoring/targets/tls.json before anything starts. No container
# ever receives it, so listing it as a live variable would promise a lever that
# reaches nothing — which is what `deploymentEnvReachesTheContainer` exists to
# catch, and did.
# OPEN_SCIENCE_PUBLIC_HEALTH_URL=https://replace-with-public-origin/api/health

# Backup and restore readiness. For production, choose either:
# - local: use docker-compose.backup.yml with the `backup` profile
# - external: platform/object-store snapshots managed outside this container
# Where the PostgreSQL backup timer on the *host* writes its receipt. Readiness
# reads that receipt to verify backups are running, fresh and restorable.
#
# It must name a host directory, not one inside the release: the compose default
# is `./postgres-backup-status`, an empty directory shipped with the release
# that nothing ever writes to, so a deployment leaving it unset has no verified
# backup. That default used to fail readiness outright on first cutover, which
# reported a backup fault on hosts whose backups were fine; it is a notice now,
# and the notice is only silenced by pointing this at the real directory.
OPEN_SCIENCE_POSTGRES_BACKUP_STATUS_DIR=/srv/evimed-science/shared/backups/postgres/status

OPEN_SCIENCE_BACKUP_MODE=local
OPEN_SCIENCE_BACKUP_DIR=/backups
OPEN_SCIENCE_BACKUP_RETENTION_DAYS=30
OPEN_SCIENCE_BACKUP_ENCRYPTION_ACK=false
OPEN_SCIENCE_BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase.txt
OPEN_SCIENCE_BACKUP_EXTERNAL_ACK=false
# Set true only after scheduled restore drills are configured and owned.
OPEN_SCIENCE_RESTORE_DRILL_ACK=false
OPEN_SCIENCE_BACKUP_INTERVAL_SECONDS=86400
OPEN_SCIENCE_BACKUP_HEALTH_GRACE_SECONDS=1800
OPEN_SCIENCE_BACKUP_RETRY_SECONDS=300
OPEN_SCIENCE_BACKUP_MAX_FAILURES=3
OPEN_SCIENCE_BACKUP_RESTORE_DRILL_EVERY=1
OPEN_SCIENCE_BACKUP_TMPFS_SIZE=2g
OPEN_SCIENCE_WEB_TMPFS_SIZE=128m
# Encrypted off-host copy used by scripts/ops/backup-data.sh. The production
# preflight above requires this URI and verifies write, read-back, integrity,
# and delete access. The target host needs the AWS CLI or a compatible executable
# selected with OPEN_SCIENCE_OBJECT_BACKUP_CLI. Keep AWS
# credentials out of this file; use the CLI credential chain, workload identity,
# or an owner-only process environment.
OPEN_SCIENCE_OBJECT_BACKUP_URI=
OPEN_SCIENCE_OBJECT_BACKUP_CLI=aws
OPEN_SCIENCE_OBJECT_BACKUP_SSE=AES256

# Production runtime: the service-hosted agent kernel, one Docker container per
# project. OPEN_SCIENCE_OPENCODE_BIN and OPEN_SCIENCE_OPENCODE_VERSION were
# removed with the second kernel; a deployment that still exports either is
# refused at startup by name rather than starting with it ignored.
#
# The kernel pin. These are the build arguments of the runtime image and the
# versions the release manifest records for it, so a deployment that moves one
# and not the others is refused as release_manifest_mismatch rather than
# launching a kernel nobody signed off.
OPEN_SCIENCE_DSH_VERSION=0.1.5-rc.2
OPEN_SCIENCE_DSH_CORDIS_VERSION=4.0.2
OPEN_SCIENCE_SOCKET_VERSION=0.1.0
OPEN_SCIENCE_NODE_VERSION=22.22.0
OPEN_SCIENCE_PNPM_VERSION=11.7.0
OPEN_SCIENCE_UV_VERSION=0.11.26
# These digests bind the exact official release archives and license texts used
# by the runtime image. Update the version and all matching digests together.
OPEN_SCIENCE_UV_SHA256_AMD64=6426a73c3837e6e2483ee344cbc00f36394d179afcba6183cb77437e67db4af0
OPEN_SCIENCE_UV_SHA256_ARM64=befa1a59c91e96eb601b0fd9a97c03dd666f17baba644b2b4db9c59a767e387e
OPEN_SCIENCE_UV_LICENSE_MIT_SHA256=860e3d7a86b84e6a7012c7a635fc64df475cebc6cce34dfeb73a5982ec58176c
OPEN_SCIENCE_RUNTIME_MODE=kernel
OPEN_SCIENCE_RUNTIME_SANDBOX_MODE=docker
# Production Compose fixes this to the isolated Unix-socket controller. The API
# container must not receive /var/run/docker.sock.
OPEN_SCIENCE_RUNTIME_CONTROLLER_TIMEOUT_MS=30000
OPEN_SCIENCE_RUNTIME_CONTROLLER_POLL_MS=500
OPEN_SCIENCE_RUNTIME_CONTAINER_IMAGE=open-science-runtime:dsh-0.1.5-rc.2-uv-0.11.26
OPEN_SCIENCE_RUNTIME_REQUIRE_IMAGE_LOCAL=true
OPEN_SCIENCE_RUNTIME_TRANSPORT=unix
OPEN_SCIENCE_RUNTIME_NETWORK_MODE=open-science-runtime-internal
OPEN_SCIENCE_RUNTIME_INTERNAL_NETWORK_NAME=open-science-runtime-internal
OPEN_SCIENCE_ALLOW_RUNTIME_NETWORK_EGRESS=false
# The named internal network reaches only the Web model and official-host
# public-source gateways. Keep arbitrary runtime egress disabled; other
# networks still require explicit opt-in.
OPEN_SCIENCE_RUNTIME_NETWORK_EGRESS_POLICY_ACK=false
OPEN_SCIENCE_RUNTIME_CPU_LIMIT=2
OPEN_SCIENCE_RUNTIME_MEMORY_LIMIT=8g
OPEN_SCIENCE_RUNTIME_PIDS_LIMIT=1024
OPEN_SCIENCE_RUNTIME_READ_ONLY_ROOT=true
OPEN_SCIENCE_RUNTIME_TMPFS=/tmp:rw,nosuid,nodev,size=64m
# Defaults to the first-party core skills copied into the Web service image.
# Set to an empty value to disable managed runtime skill deployment.
OPEN_SCIENCE_RUNTIME_SKILL_DIRS=runtime/skills/core,runtime/skills/external/ai4s-skills,runtime/skills/curated-scientific,runtime/skills/office
OPEN_SCIENCE_EVIMED_MCP_SOURCE_DIR=runtime/mcp/evimed-research
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET=
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET_FILE=
OPEN_SCIENCE_DEEPSEEK_PROVIDER_ENABLED=true
OPEN_SCIENCE_REQUIRE_ALL_SPECIALIST_ADAPTERS=true
# Prefer owner-readable mounted secret files. Do not put real provider keys in
# this example, runtime config, browser settings, or project workspaces.
OPEN_SCIENCE_DEEPSEEK_API_KEY_HOST_FILE=./secrets/deepseek-api-key.txt
OPEN_SCIENCE_DEEPSEEK_API_KEY_FILE=./secrets/deepseek-api-key.txt
OPEN_SCIENCE_MODEL_GATEWAY_SIGNING_SECRET_HOST_FILE=./secrets/model-gateway-signing-key.txt
OPEN_SCIENCE_EVIMED_API_KEY_HOST_FILE=./secrets/evimed-api-key.txt
OPEN_SCIENCE_EVIMED_API_KEY_FILE=./secrets/evimed-api-key.txt
# Gated evidence connectors (Semantic Scholar, CORE, Unpaywall, UMLS, OMIM,
# Addgene, BioGRID, OpenGWAS) use optional server-managed keys injected through
# the public-source gateway; Semantic Scholar and Unpaywall also work keyless.
# Audit each connector's credential posture (no network, no secret values):
#   node scripts/ops/check-evidence-connectors.mjs
# /api/ready reports the same posture under `publicSourceCredentials`
# (configured or not, never the value; it never fails readiness).
#
# Unpaywall: a contact email address, not a key — Unpaywall's API identifies
# callers by it. Use an address the operator monitors (a team mailbox), never a
# personal one. Empty, the gateway refuses every DOI lookup before it starts
# (`public_source_unpaywall_credential_missing`), so a paper with a DOI and no
# Europe PMC copy cannot be read at full text and cannot carry a claim. The
# control plane forwards it to the gateway, to the runtime's research server
# (EVIMED_UNPAYWALL_EMAIL, derived — do not set that one here) and, as the NCBI
# contact, to the specialist engines.
OPEN_SCIENCE_UNPAYWALL_EMAIL=
OPEN_SCIENCE_MATERIALS_PROJECT_API_KEY_HOST_FILE=./secrets/materials-project-api-key.txt
OPEN_SCIENCE_REQUIRE_MATERIALS_PROJECT=true
OPEN_SCIENCE_MATERIALS_PROJECT_API_KEY_FILE=./secrets/materials-project-api-key.txt
OPEN_SCIENCE_EVIMED_WORKLOAD_SIGNING_SECRET_HOST_FILE=./secrets/evimed-workload-signing-key.txt
OPEN_SCIENCE_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPEN_SCIENCE_DEEPSEEK_MODEL=deepseek-flash
# Thinking effort for every model call a run makes: low, high or max (DeepSeek's
# three levels since 2026-08-13). `high` is the long-standing default; `max`
# is the lever to try when a delivery line fails on number integrity before
# reaching for a different model. The platform's own short calls (memory
# extraction, routing, run titles) run with thinking off and ignore it.
OPEN_SCIENCE_DEEPSEEK_REASONING_EFFORT=high
# LLM-augmented open-domain routing. On by default; the LLM classifier only runs
# after the regex router finds no match, never overrides a deterministic
# clinical/specialty route, and fails safe to open-domain on any error. Set to
# false to fall back to regex-only routing.
OPEN_SCIENCE_LLM_ROUTING_ENABLED=true
# Automatic run titles: one small metered call per new run names it for the
# task lists; a failure, or false here, leaves the run named by its question.
OPEN_SCIENCE_RUN_TITLES_ENABLED=true
# The learning loop: queues a lesson by itself when a delivery finishes, when the
# researcher corrects the assistant, and when one capability's routine repeats;
# distils it as soon as the run ends, lets the method take effect at once, and
# consolidates the library hourly (the paired evaluation afterwards can retire
# it). On by default. The window is optional and empty means any time; the CNY
# caps (OPEN_SCIENCE_LEARNING_{RUN,DAILY,WEEKLY}_LIMIT_CNY) count learning spend
# only and are unset, i.e. no cap (owner, 2026-09-21).
OPEN_SCIENCE_LEARNING_ENABLED=true
OPEN_SCIENCE_LEARNING_WINDOW=
# The zone the window above is written in (an IANA name). The web container's
# clock is UTC; without this the window would open in Beijing daytime.
OPEN_SCIENCE_LEARNING_WINDOW_TIMEZONE=Asia/Shanghai
OPEN_SCIENCE_LEARNING_CONCURRENCY=2
OPEN_SCIENCE_LEARNING_EVALUATION_COMMAND="python3 evals/method-quality/run_paired.py --template evals/method-quality/configs/method-release-v1.json --use-holdout --holdout-reason=versioned-method-release-decision"
OPEN_SCIENCE_LLM_ROUTING_CONFIDENCE_THRESHOLD=0.75
# How long one routing classification may take before the dispatch goes on
# without it (the regex net routes instead). It is on the dispatch path, and
# with thinking off a verdict takes a second or two.
OPEN_SCIENCE_LLM_ROUTING_TIMEOUT_MS=20000
OPEN_SCIENCE_MODEL_GATEWAY_INTERNAL_URL=http://open-science-web:8787/internal/model/v1
# Where the Mendelian-randomization adapter asks for a researcher's own
# OpenGWAS token when the deployment has not configured one (below). Every other
# source resolves the same way inside the public-source gateway without a URL.
OPEN_SCIENCE_CONNECTOR_CREDENTIAL_INTERNAL_URL=http://open-science-web:8787/internal/connectors/v1/credential
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_INTERNAL_URL=http://open-science-web:8787/internal/sources/v1/fetch
# Where the six specialist engines report what a finished job spent at the
# model provider; the control plane records it in the usage ledger as
# purpose `engine`. Empty turns the reports off.
OPEN_SCIENCE_ENGINE_USAGE_INTERNAL_URL=http://open-science-web:8787/internal/usage/v1/engine
# The GEO probe host: a desktop running five consumer LLM front-ends with tabs
# already signed in, reachable over HTTP. Empty leaves `geo_visibility_probe`
# switched off, which is what a deployment that cannot measure should report --
# an estimate presented as a measurement is the failure that tool exists to
# avoid. Plaintext is opt-in because the questions and the answers travel
# unencrypted, and the signing secret is optional because a probe host that
# does not verify one is the common case.
OPEN_SCIENCE_GEO_PROBE_URL=
OPEN_SCIENCE_GEO_PROBE_ALLOW_PLAINTEXT=
OPEN_SCIENCE_GEO_PROBE_TIMEOUT_MS=150000
# Serve the kernel's own browser application as this deployment's session
# surface. Off by default: an authenticated browser then reaches that project's
# kernel surface, which is the boundary the retired pass-through route existed
# to hold, and `@evimed/domain`'s runtime-UI deny list is what bounds it.
#
# It gets an origin of its own rather than a path, because it builds every URL
# it fetches from `location.origin` -- its plugin bundles are `/plugins/...`
# and its method calls are `/api/<method>`, both absolute. Behind a path prefix
# those reach the control plane, which answers them with its own document: the
# page then dies at boot while every request reads 200.
#
# PORT is what the container listens on; the host publishes it and PUBLIC_ORIGIN
# is the address the page frames. Same host as the API, different port: a
# different origin (so the frame is isolated) on the same site (so the session
# cookie is still sent). Readiness refuses production with either one missing.
OPEN_SCIENCE_RUNTIME_UI_PROXY_ENABLED=
OPEN_SCIENCE_RUNTIME_UI_PORT=8788
OPEN_SCIENCE_RUNTIME_UI_HOST_PORT=8788
OPEN_SCIENCE_RUNTIME_UI_PUBLIC_ORIGIN=
# The EviMed layer inside that page is several bodies, each of which can be
# switched off on its own, comma-separated: theme (the teal palette and the
# shell's light/dark), toolviews (the plan and sub-task cards; the delivery
# gate's own calls draw nothing), transcript (folds a finished conversation's
# process by loading its whole history, and hides the system prompt, injected
# context and unknown-event rows from researchers), panels (the delivered
# files after the answer that delivered them, and opening the file tree on a
# new report), commands (/工具, the tool chip and its starters, the @
# knowledge-base reference), reply-checks (the 「⚠ N 处引用待核对」 row the
# independent reviewer puts under a cited answer when it found a problem),
# shell (brand, layout, and hiding the kernel's statistics) and locale (the
# product's Chinese, and the send button's queue/steer hint). The bridge is
# not switchable.
# With all of them off the kernel's own conversation still works; that is the
# control each one is measured against.
# OPEN_SCIENCE_RUNTIME_UI_FRAME_OFF=
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_TIMEOUT_MS=60000
OPEN_SCIENCE_PUBLIC_SOURCE_GATEWAY_MAX_RESPONSE_BYTES=16777216
# Web reading: `web_read` reads any public page through the gateway (robots.txt
# honoured, one request per site per second, eight reads at once, at most three
# of them one project's). Pages drawn in script are rendered in AgentBay's cloud
# browser once OPEN_SCIENCE_WEB_RENDER_ENABLED=true and an AgentBay key file is
# set; until then such a page is a named error and the run uses another source.
# PDFs and office documents go to the document parser. Retraction and correction
# flags on cited sources come from Crossref.
OPEN_SCIENCE_WEB_READ_ENABLED=true
OPEN_SCIENCE_WEB_READ_CONCURRENCY=8
OPEN_SCIENCE_WEB_READ_RUNTIME_CONCURRENCY=3
OPEN_SCIENCE_WEB_READ_HOST_INTERVAL_MS=1000
OPEN_SCIENCE_WEB_READ_EDGE_FALLBACK=true
OPEN_SCIENCE_WEB_READ_DIRECT_TIMEOUT_MS=12000
OPEN_SCIENCE_WEB_READ_TIMEOUT_MS=150000
OPEN_SCIENCE_WEB_RENDER_ENABLED=false
OPEN_SCIENCE_WEB_RENDER_CONCURRENCY=2
OPEN_SCIENCE_WEB_RENDER_TIMEOUT_MS=30000
OPEN_SCIENCE_WEB_RENDER_IDLE_RELEASE_MS=300000
OPEN_SCIENCE_SOURCE_UPDATES_ENABLED=true
OPEN_SCIENCE_SOURCE_UPDATES_TIMEOUT_MS=3000
# The render tier uses the AgentBay settings of the runtime-provider block below.
OPEN_SCIENCE_MODEL_GATEWAY_TIMEOUT_MS=300000
OPEN_SCIENCE_MODEL_GATEWAY_MAX_BODY_BYTES=12582912
OPEN_SCIENCE_MODEL_GATEWAY_MAX_RESPONSE_BYTES=33554432
OPEN_SCIENCE_SOURCE_INGESTION_ENABLED=true
# The in-house document-parsing API (deps-version.json `evimed-extract`). It is
# the parser team's service reached over HTTP; nothing of it runs on this host.
# It needs no key: with the host file below empty no Authorization header is
# sent, and PDF, Word and the other formats parse (measured 2026-09-22). A key
# goes in that file, root-owned 0400, only if the parser team turns
# authentication on. REQUIRE=true makes readiness watch the service's /health.
OPEN_SCIENCE_REQUIRE_DOCUMENT_PARSER=true
OPEN_SCIENCE_DOCUMENT_PARSER_URL=http://123.57.56.88:9011
OPEN_SCIENCE_DOCUMENT_PARSER_TOKEN_HOST_FILE=./secrets/document-parser.token
OPEN_SCIENCE_DOCUMENT_PARSER_TOKEN_FILE=/run/secrets/document-parser-token
# The whole parse, retries included.
OPEN_SCIENCE_DOCUMENT_PARSER_TIMEOUT_MS=300000
# The label the knowledge-base index is keyed by with each file's SHA-256; move
# it when the parser changes and every document is re-indexed.
OPEN_SCIENCE_DOCUMENT_PARSER_REVISION=evimed-extract@0.5.0
# The Crossref lookup that confirms a parsed document's DOI. On timeout the DOI
# stays, marked unconfirmed; the document is ingested either way.
OPEN_SCIENCE_SOURCE_DOI_CHECK_TIMEOUT_MS=8000
# Knowledge-base search: the runtime's `kb_search` tool and the index behind it
# (PostgreSQL: terms, trigram and — with the pgvector image — DashScope vectors,
# fused and reranked). Off, the tool answers "disabled", nothing is indexed or
# embedded, and a run reads the knowledge-base files as before.
OPEN_SCIENCE_KB_SEARCH_ENABLED=true
OPEN_SCIENCE_KB_SEARCH_GATEWAY_INTERNAL_URL=http://open-science-web:8787/internal/kb/v1/search
# One search, all legs and the rerank included.
OPEN_SCIENCE_KB_SEARCH_TIMEOUT_MS=20000
# Below this many tokens across a project's documents and the personal library,
# the search answers with the files to read whole instead of fragments.
OPEN_SCIENCE_KB_SMALL_LIBRARY_TOKENS=150000
# How often the index converges on the sources when nothing woke it.
OPEN_SCIENCE_KB_INDEX_RECONCILE_MS=60000
# One DashScope embedding request (ten chunks).
OPEN_SCIENCE_KB_EMBEDDING_TIMEOUT_MS=30000
# How many documents one account's personal library holds (one read-only copy
# each, mounted into every run of the account and searched beside the project).
OPEN_SCIENCE_LIBRARY_MAX_ITEMS=1000
OPEN_SCIENCE_OPENLIST_ADMIN_PASSWORD_HOST_FILE=./secrets/openlist-admin-password.txt
OPEN_SCIENCE_OPENLIST_TENANT_ROOT=/tenants
OPEN_SCIENCE_OPENLIST_MAX_DOWNLOAD_BYTES=67108864
# Whether any memory reaches a run: the memories recalled at dispatch, the
# resident capsule profile, and the recall tool and agent API (which answer
# `mode: "disabled"`). On by default; false is the no-memory control arm a
# memory evaluation compares against. Unset follows OPEN_SCIENCE_MEMORY_ENABLED.
OPEN_SCIENCE_MEMORY_RECALL_ENABLED=true
# Which component ranks a recall: `openviking` (the index this stack starts,
# which ranks both research memory and capsule facts) or `builtin` (the term
# matcher, nothing to deploy). The record itself stays in PostgreSQL either
# way, and an unreachable index falls back to the term matcher. Left unset,
# the index is used exactly when OPEN_SCIENCE_OPENVIKING_URL and its key are
# configured; /api/ready reports the choice as `memoryIndex.providerSource`.
# A `builtin` here beside `indexConfigured: true` is a pin, not a default.
OPEN_SCIENCE_MEMORY_INDEX_PROVIDER=openviking
# Report-only by default. Set true and three things change together: a research
# recall whose index is down fails instead of falling back to the term matcher,
# a capsule recall does the same instead of falling back to the lexical search,
# and `memoryIndex` becomes a required readiness check — so while the index or
# the embedding endpoint behind it is unreachable, /api/ready fails and the web
# container's healthcheck marks it unhealthy. That is the point of the switch:
# an operator who would rather see the outage than be served a degraded recall.
OPEN_SCIENCE_MEMORY_INDEX_STRICT=false
# Where the index is. The default is the service this stack starts; point it
# elsewhere only for a shared or external index.
OPEN_SCIENCE_OPENVIKING_URL=http://evimed-openviking:1933
OPEN_SCIENCE_OPENVIKING_ACCOUNT=evimed
OPEN_SCIENCE_OPENVIKING_REQUEST_TIMEOUT_MS=8000
OPEN_SCIENCE_OPENVIKING_IMAGE=ghcr.io/volcengine/openviking:v0.4.19@sha256:49e20c09ec7ea2f16c116d9ddb2ea90b4c24bf3f5a83078609e52399487dbec1
# Both written by `pnpm configure:production-state`: the index's own API key,
# and the configuration that carries the embedding credential into it. Neither
# value belongs in this file.
OPEN_SCIENCE_OPENVIKING_CONF_HOST_FILE=./secrets/openviking-ov.conf
OPEN_SCIENCE_OPENVIKING_API_KEY_HOST_FILE=./secrets/openviking-api-key.txt
# The DashScope (Alibaba Bailian) key: embeddings for the index, and reranking
# for the control plane that reads it. Unlike every other file above, this one
# is supplied by the operator — `configure:production-state` refuses to run
# without it and never generates or prints it. Owner-only (chmod 0600).
OPEN_SCIENCE_DASHSCOPE_API_KEY_HOST_FILE=./secrets/dashscope.api-key
OPEN_SCIENCE_DASHSCOPE_API_KEY_FILE=/run/secrets/dashscope-api-key
# What the control plane reranks a hydrated recall with. The defaults are the
# pins in `deps-version.json`, where the index's compatibility is recorded;
# these exist so a deployment can follow a model deprecation without a rebuild.
# The endpoint is posted to verbatim, so it is a complete URL. With no key the
# reranker is inert and the index's vector order stands.
OPEN_SCIENCE_MEMORY_RERANK_MODEL=qwen3-rerank
OPEN_SCIENCE_MEMORY_RERANK_API_BASE=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
OPEN_SCIENCE_MEMORY_RERANK_TIMEOUT_MS=3000
# How much of a recall reaches the prompt: how many memories, and how many
# characters they may spend between them.
OPEN_SCIENCE_MEMORY_CONTEXT_LIMIT=8
OPEN_SCIENCE_MEMORY_CONTEXT_MAX_CHARS=20000
OPEN_SCIENCE_AUTOPILOT_ENABLED=true
OPEN_SCIENCE_AUTOPILOT_POLL_MS=1000
OPEN_SCIENCE_AUTOPILOT_LEASE_MS=300000
OPEN_SCIENCE_REQUIRE_INBOX=true
# IM (Feishu): each researcher scans a QR code on their account page and a bot
# of their own is created in their Feishu tenant; questions sent to it run like
# questions asked on the page, progress shows on one card updated in place, and
# results, files and inbox notices arrive in Feishu. Needs PostgreSQL and a
# correct OPEN_SCIENCE_PUBLIC_URL (every card links back to it). Code default
# off; the hosted SaaS runs it on.
OPEN_SCIENCE_IM_ENABLED=true
OPEN_SCIENCE_IM_POLL_MS=2000
OPEN_SCIENCE_IM_LEASE_MS=300000
# Shortest gap between two updates of one task's progress card.
OPEN_SCIENCE_IM_PROGRESS_INTERVAL_MS=15000
# A chat message after this many quiet minutes starts a fresh conversation.
OPEN_SCIENCE_IM_CONVERSATION_IDLE_MINUTES=360
# Delivered files sent into the chat per finished task (each at most 30 MB).
OPEN_SCIENCE_IM_MAX_RESULT_FILES=5
# Messages one bound chat may have handled per minute; past it the chat is told
# once to slow down and the rest of the minute is dropped.
OPEN_SCIENCE_IM_INBOUND_PER_MINUTE=20
# Reserved channels: adapters that report "not configured" until one is built.
# Leave them off; turning one on only lets a preference name it.
OPEN_SCIENCE_CHANNEL_WECHAT_SERVICE_ENABLED=false
OPEN_SCIENCE_CHANNEL_WECHAT_CLAWBOT_ENABLED=false
OPEN_SCIENCE_CHANNEL_EMAIL_ENABLED=false
# The own app's push-token intake (no vendor push is configured yet).
OPEN_SCIENCE_CHANNEL_APP_ENABLED=false
OPEN_SCIENCE_CHANNEL_DINGTALK_ENABLED=false
OPEN_SCIENCE_CHANNEL_WECOM_ENABLED=false
# Bearer device tokens for a non-browser client (the own app, reserved). Off:
# the API accepts only the browser session cookie.
OPEN_SCIENCE_APP_API_ENABLED=false
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_HOST_FILE=./secrets/deepseek-release-receipt.json
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_FILE=./secrets/deepseek-release-receipt.json
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_ID=dsrg_replace_with_operator_gate_id
OPEN_SCIENCE_DEEPSEEK_CONFIG_REVISION=replace-with-reviewed-gateway-config-revision
OPEN_SCIENCE_DEEPSEEK_RELEASE_RECEIPT_MAX_AGE_MS=86400000
EVIMED_BIOMEDICAL_SOURCE_SEARCH_URL=
EVIMED_LITERATURE_SEARCH_URL=
EVIMED_GUIDELINE_SEARCH_URL=
EVIMED_CLINICAL_TRIAL_SEARCH_URL=
EVIMED_PATENT_SEARCH_URL=
# Base tool names the research MCP must not offer at all, comma-separated.
# An empty adapter URL above means "should work, is not configured" and fails a
# call with `adapter_unconfigured`; a name here means "this deployment does not
# do that", and the tool never reaches the model's catalogue.
EVIMED_DISABLED_TOOLS=
EVIMED_PHARMACY_REFERENCE_SEARCH_URL=
# Empty: drug_label_search runs in the runtime against the EviMed label API
# and openFDA. Set it to the drug evidence adapter,
#   http://evimed-drug-evidence-adapter:8026/api/v1/evimed/drug-label-search
# once drug-label-index.sqlite is in the data volume and the adapter image is
# rebuilt: Chinese labels then come from the index, can be read by labelId and
# are preserved for citation, and the connectors remain the fallback.
EVIMED_DRUG_LABEL_SEARCH_URL=
EVIMED_ADR_CASE_QUERY_URL=
EVIMED_ADR_SIGNAL_ANALYSIS_URL=
EVIMED_OFFLABEL_EVIDENCE_PACKET_URL=
EVIMED_COMPREHENSIVE_DRUG_EVALUATION_URL=
EVIMED_DRUG_SELECTION_EVALUATION_URL=
EVIMED_META_ANALYSIS_URL=http://evimed-meta-agent:8024/api/v1/evimed/meta-analysis
EVIMED_MR_ANALYSIS_URL=
EVIMED_BIBLIOMETRIC_ANALYSIS_URL=
EVIMED_RESEARCH_TOPIC_SELECTION_URL=
EVIMED_PEER_REVIEW_URL=
EVIMED_DRUG_SAFETY_ANALYSIS_URL=
# Optional: OpenAlex, the fallback citation source for bibliometric analysis.
# iCite is tried first and needs no key; OpenAlex has required one since
# 2026-02. Empty means the engine reports that it could not reach a citation
# graph, rather than substituting a keyword-overlap simulation for one.
OPEN_SCIENCE_OPENALEX_API_KEY=
EVIMED_META_AGENT_IMAGE=evimed-meta-agent:0.9.0
EVIMED_META_AGENT_VERSION=0.9.0

# Optional: run the OpenCode container as a non-root UID/GID after verifying
# the mounted data volume is writable by that identity.
# OPEN_SCIENCE_RUNTIME_CONTAINER_USER=1000:1000

# Keep host-level escape hatches disabled for hosted deployments.
OPEN_SCIENCE_ALLOW_RUNTIME_HOST_NETWORK=false
OPEN_SCIENCE_ALLOW_UNSANDBOXED_RUNTIME=false
OPEN_SCIENCE_ALLOW_HOST_SHELL=false
OPEN_SCIENCE_ALLOW_DIRECT_SHELL=false
OPEN_SCIENCE_ALLOW_PERSISTENT_APPROVALS=false
OPEN_SCIENCE_ALLOW_FULL_APPROVAL=false

# Capacity and rate limits.
OPEN_SCIENCE_MAX_PROJECT_BYTES=1073741824
OPEN_SCIENCE_MAX_JSON_BYTES=12582912
OPEN_SCIENCE_MAX_FILE_BYTES=52428800
# Must be at least ceil(OPEN_SCIENCE_MAX_FILE_BYTES * 1.4) + 8192 for browser/base64 uploads.
OPEN_SCIENCE_PROXY_MAX_BODY_SIZE=73408512
OPEN_SCIENCE_MAX_WORKSPACE_SCAN_ENTRIES=10000
OPEN_SCIENCE_MAX_ARCHIVE_ENTRIES=10000
OPEN_SCIENCE_MAX_ARCHIVE_BYTES=1073741824
OPEN_SCIENCE_MAX_PROJECT_USAGE_SCAN_ENTRIES=10000
OPEN_SCIENCE_MAX_LOG_READ_BYTES=1048576
OPEN_SCIENCE_MAX_LOG_FILE_BYTES=10485760
OPEN_SCIENCE_MAX_CONCURRENT_COMMANDS=8
OPEN_SCIENCE_MAX_CONCURRENT_TASKS=2
OPEN_SCIENCE_MAX_CONCURRENT_TASKS_PER_PROJECT=1
OPEN_SCIENCE_MAX_QUEUED_TASKS=100
OPEN_SCIENCE_MAX_QUEUED_TASKS_PER_PROJECT=25
OPEN_SCIENCE_COMMAND_TIMEOUT_MS=120000
OPEN_SCIENCE_RUNTIME_PROXY_CONNECT_TIMEOUT_MS=90000
OPEN_SCIENCE_RUNTIME_PROXY_REQUEST_TIMEOUT_MS=120000
# An idle runtime stays warm this long (12 h), and past the yield age (30 min)
# gives its slot to another researcher's start when the deployment is full.
OPEN_SCIENCE_RUNTIME_IDLE_TIMEOUT_MS=43200000
OPEN_SCIENCE_RUNTIME_IDLE_YIELD_AFTER_MS=1800000
OPEN_SCIENCE_RUNTIME_QUOTA_CHECK_INTERVAL_MS=30000
OPEN_SCIENCE_MAX_RUNTIME_PROXY_CONNECTIONS=64
OPEN_SCIENCE_MAX_RUNTIME_PROXY_CONNECTIONS_PER_PROJECT=8
# Delegation inside one run: how many children it may start over its whole
# life, and how many may work at the same time (also the literature-screening
# wave). Both default to 30. Recreate the web and runtime-controller containers
# after changing them; the controller builds the hosted launch plan.
# OPEN_SCIENCE_MAX_CHILDREN_TOTAL=30
# OPEN_SCIENCE_MAX_CONCURRENT_CHILDREN=30
# Compaction inside a runtime. `basic` is the kernel's own engine; `structured`
# keeps the run's handles across a compaction. The threshold is a fraction of
# the declared context window (0.8 x 400,000 = 320,000 tokens by default). The
# request-size guard forces one compaction when a request reaches this many
# bytes; unset it is three quarters of OPEN_SCIENCE_MODEL_GATEWAY_MAX_BODY_BYTES,
# and 0 turns it off. Readiness reports the threshold and the guard. Recreate the
# web and runtime-controller containers after changing any of them.
# OPEN_SCIENCE_RUNTIME_COMPACTION_POLICY=basic
# OPEN_SCIENCE_RUNTIME_COMPACTION_THRESHOLD_RATIO=0.8
# OPEN_SCIENCE_RUNTIME_COMPACTION_RETAIN_RATIO=0.16
# OPEN_SCIENCE_RUNTIME_COMPACTION_MAX_TOKENS=8192
# OPEN_SCIENCE_RUNTIME_COMPACTION_MAX_REQUEST_BYTES=9437184
# These limits are enforced independently by both the API and Runtime Controller.
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES=8
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES_PER_USER=4
OPEN_SCIENCE_RATE_LIMIT_MAX_REQUESTS=600
OPEN_SCIENCE_AUTH_RATE_LIMIT_MAX_REQUESTS=20
OPEN_SCIENCE_COMMAND_RATE_LIMIT_MAX_REQUESTS=120
# Required by the bundled production Caddy boundary. Caddy overwrites
# X-Forwarded-For before the API uses its validated IP for rate limiting.
OPEN_SCIENCE_TRUST_PROXY=true

# Optional comma-separated extra frontend origins when API and frontend differ.
OPEN_SCIENCE_CORS_ORIGINS=

# Local smoke-test only:
# NODE_ENV=development
# OPEN_SCIENCE_PUBLIC_URL=http://localhost:8787
# OPEN_SCIENCE_RUNTIME_MODE=mock
# OPEN_SCIENCE_ALLOW_MOCK_RUNTIME=true

# Optional: add docker-compose.specialist-audit.yml only for signed public MR audits.
# Host file must be PKCS8 Ed25519, owned by trusted adapter UID 0, mode 0400 or 0600.
# Leave empty and omit that overlay for ordinary unsigned MR deployments.
OPEN_SCIENCE_SPECIALIST_AUDIT_SIGNING_KEY_HOST_FILE=

# rt: runtime UX (2026-09-20). Start the runtime of the account's most recently
# used project in the background of a sign-in, so it is up when the project is
# opened. false costs the first open its cold start and nothing else.
OPEN_SCIENCE_RUNTIME_WARM_ON_SIGN_IN=true

# rt: the AgentBay runtime provider (plan §3.1, 2026-09-20). `docker` runs each
# project's runtime as a container on this host behind the runtime controller;
# `agentbay` runs it in an Alibaba AgentBay cloud session, one per project.
# Switching to agentbay also takes: docker-compose.agentbay.yml with the key
# file below, the image id scripts/ops/agentbay-image-build.sh activated, the
# public gateway prefix below with its host proxy location, and the two runtime
# caps above set to 100 and 2. OPEN_SCIENCE_RUNTIME_TRANSPORT stays unix: an
# AgentBay runtime is always reached over its session link.
OPEN_SCIENCE_RUNTIME_PROVIDER=docker
# Host file holding the AgentBay API key: one line, mode 0600. Read by the
# control plane only; leave empty and omit the overlay while on Docker.
OPEN_SCIENCE_AGENTBAY_API_KEY_HOST_FILE=
OPEN_SCIENCE_AGENTBAY_REGION=cn-hangzhou
# Empty: the SDK's own endpoint for the region.
OPEN_SCIENCE_AGENTBAY_ENDPOINT=
# The activated custom image (imgc-...).
OPEN_SCIENCE_AGENTBAY_IMAGE_ID=
# AgentBay's own lifecycle: a session is released after this long without an
# SDK call (the control plane's heartbeat makes one every 25 s) and after this
# long in all.
OPEN_SCIENCE_AGENTBAY_IDLE_RELEASE_MINUTES=30
OPEN_SCIENCE_AGENTBAY_MAX_RUNTIME_MINUTES=240
OPEN_SCIENCE_AGENTBAY_HEARTBEAT_MS=25000
# A console-side network policy (domain allowlist / security group) sessions
# are created under; empty for none. The in-image firewall applies either way.
OPEN_SCIENCE_AGENTBAY_POLICY_ID=
# The session bridge's port (a link opens 30100-30199) and how its per-session
# secret travels: `header`, or `path` if the link proxy strips custom headers.
OPEN_SCIENCE_AGENTBAY_BRIDGE_PORT=30100
OPEN_SCIENCE_AGENTBAY_BRIDGE_SECRET_MODE=header
# A remote runtime's workload token: its life, and how often it is renewed
# through the session's file API (renewal x 2 must stay under the life).
OPEN_SCIENCE_AGENTBAY_WORKLOAD_TOKEN_TTL_SECONDS=900
OPEN_SCIENCE_AGENTBAY_WORKLOAD_TOKEN_REFRESH_SECONDS=300
# The Landlock level a guest kernel must offer: full (ABI 5 or later) or
# partial (ABI 1-4). A kernel without Landlock is never served.
OPEN_SCIENCE_AGENTBAY_SANDBOX_ENFORCEMENT=full
# Refuse a session whose egress firewall could not be applied.
OPEN_SCIENCE_AGENTBAY_FIREWALL_REQUIRED=true
# Session-to-host mirror period, and the largest file carried either way.
OPEN_SCIENCE_AGENTBAY_SYNC_INTERVAL_MS=15000
OPEN_SCIENCE_AGENTBAY_SYNC_MAX_FILE_BYTES=268435456
OPEN_SCIENCE_AGENTBAY_CONTEXT_PREFIX=evimed
# The https prefix a session reaches every runtime gateway through, e.g.
# https://<domain>/runtime-gateway, forwarded to the web API by the host proxy;
# and the requests a minute one runtime may make through it.
OPEN_SCIENCE_RUNTIME_GATEWAY_PUBLIC_URL=
OPEN_SCIENCE_RUNTIME_GATEWAY_RATE_LIMIT_PER_MINUTE=600

# rt: the community client bundles the runtime image installs (plan §3.9):
# selection annotation in the conversation view, and Mermaid diagrams in
# replies. Each is on; false switches it off for every runtime this control
# plane starts next — the answer when an upgrade breaks one.
OPEN_SCIENCE_RUNTIME_ANNOTATION_ENABLED=true
OPEN_SCIENCE_RUNTIME_MERMAID_ENABLED=true

# The Tokyo node: a TLS forward proxy for what this host is refused
# (apps/server/src/edgeProxy.mjs). Empty URL = no node.
OPEN_SCIENCE_EDGE_PROXY_URL=
# Host file with user:password for the node's proxy (0400); unset binds /dev/null.
OPEN_SCIENCE_EDGE_PROXY_CREDENTIALS_HOST_FILE=
OPEN_SCIENCE_EDGE_PROXY_HOSTS=gtexportal.org,api.omim.org,api.materialsproject.org
OPEN_SCIENCE_EDGE_PROXY_CONNECT_TIMEOUT_MS=10000
# The node's own SearXNG as the node sees it, e.g. http://127.0.0.1:8888/search
OPEN_SCIENCE_WEB_SEARCH_EDGE_URL=
# Qwen's web search on Bailian next to SearXNG, with the DashScope key above.
OPEN_SCIENCE_WEB_SEARCH_BAILIAN_ENABLED=false
OPEN_SCIENCE_WEB_SEARCH_BAILIAN_MODEL=qwen-plus

# 「前沿动态」, the frontier feed (apps/server/src/frontierService.mjs), and the
# knowledge-source plugin it reads (docker-compose.knowledge.yml). Off by
# default: it needs PostgreSQL, an operator account in OPEN_SCIENCE_OPERATOR_USERS
# (its model calls are billed to that account's internal project
# `evimed-frontier`) and the plugin. `operators` shows it to operators and the
# preview list only — the one-week dry run; `all` to everyone.
OPEN_SCIENCE_FRONTIER_ENABLED=false
OPEN_SCIENCE_FRONTIER_AUDIENCE=all
OPEN_SCIENCE_FRONTIER_PREVIEW_USERS=
OPEN_SCIENCE_FRONTIER_POLL_MS=5000
OPEN_SCIENCE_FRONTIER_LEASE_MS=600000
OPEN_SCIENCE_FRONTIER_MODEL=deepseek-flash
OPEN_SCIENCE_FRONTIER_DAILY_TIME=07:30
OPEN_SCIENCE_FRONTIER_TIMEZONE=Asia/Shanghai
# The pipeline's own model money per day, in CNY (past 80% only urgent items
# are edited, past 100% none); 0 is no cap.
OPEN_SCIENCE_FRONTIER_DAILY_BUDGET_CNY=10
OPEN_SCIENCE_FRONTIER_PROCESS_CONCURRENCY=2
OPEN_SCIENCE_FRONTIER_OFFPEAK=true
OPEN_SCIENCE_FRONTIER_SELECT_THRESHOLD=70
# The plugin: its address (the overlay defaults it to the compose service), the
# token file inside the container, how often the stream is pulled, one
# request's deadline, and the lowest contract version this platform consumes.
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_URL=
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_TOKEN_FILE=/run/secrets/knowledge-plugin-token
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_POLL_MS=60000
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_TIMEOUT_MS=8000
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_MIN_CONTRACT=1.0
# Host files for docker-compose.knowledge.yml (root:root 0400; unset binds
# /dev/null): the bearer token both containers share, and the plugin's own
# database password and optional upstream keys. The image is pinned by digest.
OPEN_SCIENCE_KNOWLEDGE_PLUGIN_TOKEN_HOST_FILE=
EVIMED_KNOWLEDGE_PLUGIN_IMAGE=
KNOWLEDGE_PLUGIN_DB_PASSWORD_HOST_FILE=
KNOWLEDGE_PLUGIN_NCBI_KEY_HOST_FILE=
KNOWLEDGE_PLUGIN_OPENFDA_KEY_HOST_FILE=
KNOWLEDGE_PLUGIN_EVIMED_API_KEY_HOST_FILE=

# 「循证 GEO」 (apps/server/src/geoService.mjs): drug-GEO projects — evidence,
# question map, measured diagnosis, sources, content, distribution, monitoring.
# Off by default: it needs PostgreSQL. `operators` shows it to operators and the
# preview list (user ids) only; `all` to everyone. Its own model calls (parsing
# and judging measured answers, purpose `geo`) are held by a daily budget in CNY
# (0 = no cap). Engines are the probe host's tabs (doubao, qianwen, deepseek,
# yuanbao, kimi; wenxin only through the inclusion channel). Large measurement
# rounds wait for the night window (HH-HH in the time zone); one project asks at
# most the weekly cap.
OPEN_SCIENCE_GEO_ENABLED=false
OPEN_SCIENCE_GEO_AUDIENCE=operators
OPEN_SCIENCE_GEO_PREVIEW_USERS=
OPEN_SCIENCE_GEO_POLL_MS=5000
OPEN_SCIENCE_GEO_LEASE_MS=600000
OPEN_SCIENCE_GEO_DAILY_BUDGET_CNY=20
OPEN_SCIENCE_GEO_ENGINES=doubao,qianwen,deepseek,yuanbao,kimi
OPEN_SCIENCE_GEO_NIGHT_WINDOW=22-07
OPEN_SCIENCE_GEO_TIMEZONE=Asia/Shanghai
OPEN_SCIENCE_GEO_WEEKLY_ASK_CAP=1500
# The six-platform social channel's origin (its /api/crawl answers real
# phrasings; UGC is minimised before anything is kept). Empty = no channel, and
# `social_posts_search` is not offered. The timeout stays under the kernel's
# tool-call ceiling (at most 140000).
OPEN_SCIENCE_GEO_SOCIAL_URL=
OPEN_SCIENCE_GEO_SOCIAL_TIMEOUT_MS=120000
# Engines measured through the marketplace's inclusion check instead of the
# probe host (only `wenxin` is meant to be listed); needs the marketplace below.
OPEN_SCIENCE_GEO_INCLUSION_ENGINES=
# The media marketplace (「开放平台API」): its base URL and the path of its API
# key file inside the container. Either empty = not wired: plans and budgets
# work, no order leaves. The balance cap (CNY) bounds top-up requests; unset =
# none is ever requested.
OPEN_SCIENCE_MEDIA_MARKET_URL=
OPEN_SCIENCE_MEDIA_MARKET_API_KEY_FILE=
OPEN_SCIENCE_MEDIA_MARKET_BALANCE_CAP_CNY=

# The independent reviewer (apps/server/src/reviewService.mjs; plan 2026-09-22,
# tiered review): Qwen3.8-Max on DashScope, with the DashScope key above,
# reviewing every submitted deliverable (every reference resolved, an engine
# report's numbers traced to its output, one editor pass, findings the run
# answers) and checking every cited or medicine-naming reply after it is shown.
# Off by default: it needs PostgreSQL and the key. Nothing it finds withholds a
# delivery. The model and endpoint default to the pin in deps-version.json.
OPEN_SCIENCE_REVIEW_ENABLED=false
OPEN_SCIENCE_REVIEW_MODEL=
OPEN_SCIENCE_REVIEW_API_BASE=
# One editor pass may think for minutes on a long report; the runtime polls.
OPEN_SCIENCE_REVIEW_EDITOR_TIMEOUT_MS=900000
# The editor's reasoning ceiling. A 64 KB package spent all of 8,000 on both
# live passes (2026-09-23); a small one spends 1.4–2.7k, so a ceiling only
# binds where the package needs it. Output must hold the budget and the answer.
OPEN_SCIENCE_REVIEW_THINKING_BUDGET=16000
OPEN_SCIENCE_REVIEW_MAX_OUTPUT_TOKENS=32000
# Editor passes one deliverable may have in one turn (the first and one after
# the repair); the deterministic checks run on every submission.
OPEN_SCIENCE_REVIEW_EDITOR_PASSES=2
OPEN_SCIENCE_REVIEW_REPLIES_ENABLED=true
OPEN_SCIENCE_REVIEW_REPLY_TIMEOUT_MS=90000
OPEN_SCIENCE_REVIEW_REPLY_CONCURRENCY=2
OPEN_SCIENCE_REVIEW_POLL_MS=3000
OPEN_SCIENCE_REVIEW_REFERENCE_TIMEOUT_MS=8000
# TypeSafe's Jev, the reply check's first pass (apps/server/src/replyCheckJev.mjs):
# a cited sentence Jev is sure its source supports, naming no medicine, is
# marked supported without a reviewer call; every other sentence still goes to
# the reviewer model. Model, gate and ceilings are the pin (typesafe.review in
# deps-version.json). The host file holds TypeSafe's key (owner-only 0600, like
# the DashScope key above); unset binds /dev/null and Jev stays off. With a key
# it is on unless OPEN_SCIENCE_REVIEW_JEV_ENABLED=false. The timeout is how long
# a reply check waits for Jev before the reviewer takes every sentence (unset:
# 15000 ms).
OPEN_SCIENCE_TYPESAFE_API_KEY_HOST_FILE=
OPEN_SCIENCE_REVIEW_JEV_ENABLED=
OPEN_SCIENCE_REVIEW_JEV_TIMEOUT_MS=
