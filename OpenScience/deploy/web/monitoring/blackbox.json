{
  "modules": {
    "http_2xx": {
      "prober": "http",
      "timeout": "10s",
      "http": {
        "method": "GET",
        "preferred_ip_protocol": "ip4",
        "follow_redirects": false
      }
    },
    "https_2xx": {
      "prober": "http",
      "timeout": "10s",
      "http": {
        "method": "GET",
        "preferred_ip_protocol": "ip4",
        "follow_redirects": false,
        "tls_config": {
          "insecure_skip_verify": false
        }
      }
    },
    "tls_connect": {
      "prober": "tcp",
      "timeout": "10s",
      "tcp": {
        "tls": true,
        "preferred_ip_protocol": "ip4",
        "tls_config": {
          "insecure_skip_verify": false
        }
      }
    }
  }
}
