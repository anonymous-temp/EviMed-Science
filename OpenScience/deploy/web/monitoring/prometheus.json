{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s",
    "external_labels": {
      "service": "open-science-web"
    }
  },
  "rule_files": [
    "/etc/prometheus/rules/*.json"
  ],
  "alerting": {
    "alertmanagers": [
      {
        "static_configs": [
          {
            "targets": ["alertmanager:9093"]
          }
        ]
      }
    ]
  },
  "scrape_configs": [
    {
      "job_name": "open-science-web",
      "metrics_path": "/api/ops/metrics",
      "authorization": {
        "type": "Bearer",
        "credentials_file": "/run/secrets/operator_metrics_token"
      },
      "static_configs": [
        {
          "targets": ["open-science-web:8787"]
        }
      ]
    },
    {
      "job_name": "open-science-health",
      "metrics_path": "/probe",
      "params": {
        "module": ["http_2xx"]
      },
      "static_configs": [
        {
          "targets": ["http://open-science-web:8787/api/health"]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": ["__address__"],
          "target_label": "__param_target"
        },
        {
          "source_labels": ["__param_target"],
          "target_label": "instance"
        },
        {
          "target_label": "__address__",
          "replacement": "blackbox-exporter:9115"
        }
      ]
    },
    {
      "job_name": "open-science-readiness",
      "metrics_path": "/probe",
      "params": {
        "module": ["http_2xx"]
      },
      "static_configs": [
        {
          "targets": ["http://open-science-web:8787/api/ready"]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": ["__address__"],
          "target_label": "__param_target"
        },
        {
          "source_labels": ["__param_target"],
          "target_label": "instance"
        },
        {
          "target_label": "__address__",
          "replacement": "blackbox-exporter:9115"
        }
      ]
    },
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": ["prometheus:9090"]
        }
      ]
    },
    {
      "job_name": "alertmanager",
      "static_configs": [
        {
          "targets": ["alertmanager:9093"]
        }
      ]
    },
    {
      "job_name": "blackbox-exporter",
      "static_configs": [
        {
          "targets": ["blackbox-exporter:9115"]
        }
      ]
    }
  ]
}
