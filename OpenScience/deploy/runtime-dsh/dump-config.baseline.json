  name: '@evimed/dsh-socket/plugins/web'
  config:
    searchUrl: !!js process.env.EVIMED_WEB_SEARCH_GATEWAY_URL
    fetchUrl: !!js process.env.EVIMED_PUBLIC_SOURCE_GATEWAY_URL
    tokenFile: !!js process.env.EVIMED_MODEL_GATEWAY_TOKEN_FILE
- id: preset-evimed-universal
  name: '@deepseek-ai/dsh-agent-preset'
  config:
    id: evimed-universal
    name: EviMed
    description: EviMed 统一组合：一个会话一个组合，能力由模型在运行中组合，契约绑在产出上。
    order: 0
    plugins:
      - id: persona
        name: '@deepseek-ai/dsh-persona'
        config:
          prefix: >-
            你是 EviMed 的医学研究助手，基于 {{model}} 模型，工作目录 {{cwd}}。你具备广泛的医学知识。
            简单问题直接回答；需要交付物的任务，先写下计划（含澄清或假设），然后默认就在这次对话里把它做完——
            检索、读原文、记证据、写报告、提交，都在这次对话里完成。
            只有同时有多件互相独立的活可以并行，或者一段附带工作会带回大量你不会再用的内容时，才委派。
            用用户的语言回答，内部名词不对用户说；回答只写对读者有用的内容，不讲自己怎么检索、核对或参考了哪条记忆。
            所有事实性主张尽量附文献依据；不编造文献；不提供具体诊疗建议。
      - id: evimed-core
        name: cordis:group
        group: true
        isolate:
          evimedCapabilities: true
          evimedCapsuleMethods: true
          evimedEvidence: true
        config:
          - id: evimed-guidance
            config:
              enabled: !!js process.env.EVIMED_GUIDANCE_ENABLED !== '0'
              capabilitiesDir: !!js process.env.EVIMED_CAPABILITIES_DIR
              answerPersonaDir: !!js process.env.EVIMED_ANSWER_PERSONA_DIR
              askUserEnabled: !!js process.env.EVIMED_ASK_USER === '1'
              capsuleActive: !!js process.env.EVIMED_CAPSULE_ACTIVE === '1'
              reviewEnabled: !!js process.env.EVIMED_REVIEW_ENABLED === '1'
              disabledToolsFile: !!js process.env.EVIMED_DISABLED_TOOLS_FILE ?? ''
              runPolicyEnabled: !!js process.env.EVIMED_RUN_POLICY_ENABLED !== '0'
              capsuleEnabled: !!js process.env.EVIMED_CAPSULE_ENABLED !== '0'
            name: '@evimed/dsh-socket/plugins/guidance'
          - id: evimed-run-policy
            config:
              enabled: !!js process.env.EVIMED_RUN_POLICY_ENABLED !== '0'
              deliveryAttemptLimit: !!js Number(process.env.EVIMED_DELIVERY_ATTEMPT_LIMIT ?? 3)
              maxChildrenTotal: !!js Number(process.env.EVIMED_MAX_CHILDREN_TOTAL ?? 30)
              maxConcurrentChildren: !!js Number(process.env.EVIMED_MAX_CONCURRENT_CHILDREN ?? 30)
              maxSteps: !!js Number(process.env.EVIMED_MAX_STEPS ?? 200)
              maxTokens: !!js Number(process.env.EVIMED_MAX_TOKENS ?? 400000)
              capabilitiesDir: !!js process.env.EVIMED_CAPABILITIES_DIR
              skillsDir: !!js process.env.EVIMED_CAPABILITY_SKILLS_DIR
              bundleVersion: !!js process.env.EVIMED_BUNDLE_VERSION
              revisionAuthorizeUrl: !!js process.env.EVIMED_REVISION_AUTHORIZE_URL
              tokenFile: !!js process.env.EVIMED_WORKLOAD_TOKEN_FILE
              revisionAuthorizeTimeoutMs: 3000
              reviewEnabled: !!js process.env.EVIMED_REVIEW_ENABLED === '1'
              guidanceEnabled: !!js process.env.EVIMED_GUIDANCE_ENABLED !== '0'
              disabledToolsFile: !!js process.env.EVIMED_DISABLED_TOOLS_FILE ?? ''
            name: '@evimed/dsh-socket/plugins/run-policy'
          - id: evimed-evidence
            config:
              enabled: !!js process.env.EVIMED_EVIDENCE_ENABLED !== '0'
              evidenceStaleMinutes: !!js Number(process.env.EVIMED_EVIDENCE_STALE_MINUTES ?? 10)
            name: '@evimed/dsh-socket/plugins/evidence'
          - id: evimed-capsule
            config:
              enabled: !!js process.env.EVIMED_CAPSULE_ENABLED !== '0'
              methodsDir: !!js process.env.EVIMED_CAPSULE_METHODS_DIR
              recallUrl: !!js process.env.EVIMED_CAPSULE_GATEWAY_URL
              tokenFile: !!js process.env.EVIMED_WORKLOAD_TOKEN_FILE
            name: '@evimed/dsh-socket/plugins/capsule'
      - id: evimed-screening
        config:
          enabled: !!js process.env.EVIMED_SCREENING_ENABLED !== '0'
          batchSize: !!js Number(process.env.EVIMED_SCREENING_BATCH_SIZE ?? 50)
          maxConcurrentChildren: !!js Number(process.env.EVIMED_MAX_CONCURRENT_CHILDREN ?? 30)
        name: '@evimed/dsh-socket/plugins/screening'
      - id: evimed-review
        name: '@evimed/dsh-socket/plugins/review'
        disabled: !!js process.env.EVIMED_REVIEW_ENABLED !== '1'
      - id: evimed-citation-bridge
        name: '@evimed/dsh-socket/plugins/citation-bridge'
        config:
          gatewayUrl: !!js process.env.EVIMED_PUBLIC_SOURCE_GATEWAY_URL
          tokenFile: !!js process.env.EVIMED_MODEL_GATEWAY_TOKEN_FILE
          enabled: !!js process.env.EVIMED_CITE_ENABLED !== '0'
          timeoutMs: !!js Number(process.env.EVIMED_CITE_TIMEOUT_MS || 15000)
          revision: !!js Number(process.env.EVIMED_CITE_CONFIG_REVISION || 0)
      - id: tool-bash
        name: '@deepseek-ai/dsh-tool-bash'
      - id: tool-fs
        name: '@deepseek-ai/dsh-tool-fs'
      - id: tool-fs-search
        name: '@deepseek-ai/dsh-tool-fs-search'
        config:
          sampleOverCapGlobResults: false
      - id: tool-jobs
        name: '@deepseek-ai/dsh-tool-jobs'
      - id: skill-filesystem
        name: '@deepseek-ai/dsh-skill-filesystem'
        config:
          includeDefaultRoots: false
          customSkillDirs:
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/core'
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/evimed'
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/curated-scientific'
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/office'
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/geo-private/skills'
            - !!js process.env.EVIMED_PRESET_SKILLS_DIR + '/community'
      - id: tool-skill
        name: '@deepseek-ai/dsh-tool-skill'
      - id: tool-ask-user
        name: '@deepseek-ai/dsh-tool-ask-user'
        disabled: !!js process.env.EVIMED_ASK_USER !== '1'
      - id: compaction
        name: cordis:group
        group: true
        isolate:
          compaction: true
          toolResultPruner: true
        config:
          - id: compaction-basic
            name: '@deepseek-ai/dsh-compaction-basic'
            config:
              thresholdRatio: !!js Number(process.env.EVIMED_COMPACTION_THRESHOLD_RATIO ?? 0.8)
              retainRatio: !!js Number(process.env.EVIMED_COMPACTION_RETAIN_RATIO ?? 0.16)
              maxTokens: !!js Number(process.env.EVIMED_COMPACTION_MAX_TOKENS ?? 8192)
          - id: evimed-compaction
            name: '@evimed/dsh-socket/plugins/compaction'
            config:
              enabled: !!js process.env.EVIMED_COMPACTION_ENABLED !== '0'
              policy: !!js process.env.EVIMED_COMPACTION_POLICY ?? 'basic'
              thresholdRatio: !!js Number(process.env.EVIMED_COMPACTION_THRESHOLD_RATIO ?? 0.8)
              retainRatio: !!js Number(process.env.EVIMED_COMPACTION_RETAIN_RATIO ?? 0.16)
              maxTokens: !!js Number(process.env.EVIMED_COMPACTION_MAX_TOKENS ?? 8192)
              maxRequestBytes: !!js Number(process.env.EVIMED_COMPACTION_MAX_REQUEST_BYTES ?? 0)
          - id: tool-result-pruner
            name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
            config:
              thresholdChars: 8192
              headChars: 4096
              tailChars: 1024
# == dsh-cite
- id: cite
  name: dsh-cite
  config:
    timeoutMs: 15000
# == dsh-mermaid
- id: ui-mermaid
  name: dsh-mermaid
