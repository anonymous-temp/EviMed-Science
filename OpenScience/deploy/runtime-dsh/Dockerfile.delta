# A dependency-preserving delta of the runtime image.
#
# WHY THIS EXISTS. The full runtime build installs Debian packages, R,
# Chromium, uv, Node and the pinned DSH CLI before it ever reaches our own
# code; on the production host those steps are the build. A change that
# touches only `packages/socket`, `packages/harness-port` and
# `packages/domain` — no new dependency, no changed lockfile — does not need
# any of them rebuilt, and `docs/WEB_DEPLOYMENT.md` admits exactly that case
# as "a dependency-preserving delta". This replays the tail of `Dockerfile`
# from the socket bundle onward, on top of a base image that is itself a
# verified release.
#
# WHAT MAKES IT SAFE, and the reason each line is here rather than a `COPY`
# over the old one:
#
#   - Every directory it replaces was sealed `a-w` by the full build. Root
#     ignores the mode, so a plain COPY would half-overwrite a read-only tree
#     and leave whichever files the new bundle no longer has. Each is removed
#     first, so what ships is the new tree and nothing of the old one.
#   - The socket is in FOUR places in a built image: `/opt/evimed/socket`,
#     the preset inside it, the copy of that preset under the kernel's own
#     preset root, and the profile seed's installed copy — which is the only
#     one a running container ever imports. A delta that refreshed three of
#     them would boot the old plugins and look like the build had not taken.
#   - The seed carries a digest seal the boot-time migration checks, so it is
#     re-sealed after being written to, not before.
#   - `build-smoke.sh` BOOTS the relocated seed and imports a plugin. It is
#     the acceptance for this file: three of the four checks in the full build
#     passed once on an image whose bundle could not be imported at all.
#
# NOT ADMISSIBLE HERE: a changed `pnpm-lock.yaml`, a new dependency, a kernel
# pin move, or anything under `runtime/` other than the curated skills' prose
# and the research MCP server's own Python sources (see those steps).
# Those change what the base installed, and the base is what this trusts.
# Build the full `Dockerfile` for them.
ARG RUNTIME_BASE_IMAGE
FROM ${RUNTIME_BASE_IMAGE}

ARG DSH_PRESET_ROOT=/opt/evimed/dsh/presets
ARG DSH_HOME_SEED=/opt/evimed/dsh-home-seed
ARG SOCKET_VERSION=0.1.0

USER root

# The sealed trees this delta rewrites, removed rather than written over.
RUN set -eux; \
  rm -rf /opt/evimed/socket /opt/evimed/capabilities /opt/evimed/capability-skills

# The baseline this delta must match is the one in the source being built, not
# the one the base image was built against. A delta that changes the
# composition — a new plugin row, a provider named where none was — moves the
# resolved config on purpose, and comparing it against the base's frozen copy
# would report the intended change as drift and refuse every such delta.
COPY deploy/runtime-dsh/dump-config.baseline.json /opt/evimed/committed-dump-config.baseline.json

COPY packages/socket /opt/evimed/socket
COPY deploy/runtime-dsh/capabilities /opt/evimed/capabilities
COPY capability-skills /opt/evimed/capability-skills
COPY packages/domain /opt/evimed/socket/node_modules/@evimed/domain
COPY packages/harness-port /opt/evimed/socket/node_modules/@evimed/harness-port

RUN set -eux; \
  node /opt/evimed/socket/scripts/build-client.mjs; \
  test -s /opt/evimed/socket/dist/client.js

# The research MCP server's Python sources, and nothing the full build
# generated beside them.
#
# Admissible only while the change imports nothing outside the standard library
# and this directory: the base installed everything the server depends on. The
# full build also generated `data/sider-4.1.sqlite` into this same tree from
# pinned upstream bytes, a step that needs the network, so the tree is not
# replaced whole — the sources are copied over it and the generated index
# stays. A module deleted from the source would linger, so a deletion, a
# changed `build_sider_cache.py` or a new third-party import is a full build.
# Importing every module is the acceptance: a source that needs something the
# base does not have fails here, not in a run.
COPY runtime/mcp/evimed-research/*.py /opt/evimed/mcp/evimed-research/
RUN set -eux; \
  test -s /opt/evimed/mcp/evimed-research/data/sider-4.1.sqlite; \
  cd /opt/evimed/mcp/evimed-research; \
  for module in *.py; do python3 -c "import sys; sys.path.insert(0, '.'); import ${module%.py}"; done; \
  chmod -R a-w /opt/evimed/mcp

# The curated skills' instructions. The base installed this tree from its own
# source and smoke-tested the scripts in it, so a delta may move the prose —
# each SKILL.md, and the inventory and repin ledger that pin its digest — and
# nothing else. Without this step a SKILL.md edit reached the web image and the
# release manifest but not the runtime a run loads the skill from (2026-09-17,
# citation-integrity). Any other file that differs from the base is a change
# the base never tested, and the build stops: build the full Dockerfile.
COPY runtime/skills/curated-scientific /tmp/evimed-curated-source
RUN set -eux; \
  live=/usr/local/share/evimed/skills/curated-scientific; \
  source=/tmp/evimed-curated-source; \
  moved="$(diff -rq -x __pycache__ -x '*.pyc' "${live}" "${source}" | grep -Ev '/SKILL\.md differ$|/(inventory\.json|digest-repins\.jsonl) differ$' || true)"; \
  if [ -n "${moved}" ]; then echo "curated skills changed beyond their prose; build the full Dockerfile:" >&2; echo "${moved}" >&2; exit 1; fi; \
  (cd "${source}" && find . -name __pycache__ -prune -o \( -name SKILL.md -o -name inventory.json -o -name digest-repins.jsonl \) -type f -print) \
    | while read -r file; do install -m 0644 "${source}/${file}" "${live}/${file}"; done; \
  diff -rq -x __pycache__ -x '*.pyc' "${live}" "${source}"; \
  rm -rf "${source}"

# The preset's system-trusted skill roots, and the copy of the preset under the
# kernel's own root. Both are rebuilt from the skill trees the base already has.
RUN set -eux; \
  install -d -m 0755 /opt/evimed/socket/presets/evimed-universal/skills; \
  cp -a /opt/evimed/skills/core /opt/evimed/socket/presets/evimed-universal/skills/core; \
  cp -a /opt/evimed/skills/evimed /opt/evimed/socket/presets/evimed-universal/skills/evimed; \
  cp -a /usr/local/share/evimed/skills/curated-scientific /opt/evimed/socket/presets/evimed-universal/skills/curated-scientific; \
  cp -a /usr/local/share/evimed/skills/office /opt/evimed/socket/presets/evimed-universal/skills/office; \
  cp -a /opt/evimed/skills/community /opt/evimed/socket/presets/evimed-universal/skills/community; \
  chmod -R a-w /opt/evimed/socket /opt/evimed/capabilities /opt/evimed/capability-skills

RUN set -eux; \
  rm -rf "${DSH_PRESET_ROOT}/evimed-universal"; \
  mkdir -p "${DSH_PRESET_ROOT}"; \
  cp -a /opt/evimed/socket/presets/evimed-universal "${DSH_PRESET_ROOT}/evimed-universal"; \
  chmod -R a-w "${DSH_PRESET_ROOT}/evimed-universal"; \
  grep -q "^name: evimed-universal$" "${DSH_PRESET_ROOT}/evimed-universal/preset.yml"; \
  test -f "${DSH_PRESET_ROOT}/evimed-universal/agent.cordis.yml"

# The copy a running container actually imports.
#
# pnpm installed it from `file:/opt/evimed/socket` as a plain directory under
# `.pnpm/`, so refreshing it is a directory replacement and not an install —
# which is what keeps this delta offline. The path is found rather than
# spelled: it encodes the relative source path pnpm saw, and that is the
# base's business, not this file's.
RUN set -eux; \
  chmod -R u+w "${DSH_HOME_SEED}"; \
  installed="$(dirname "$(readlink -f "${DSH_HOME_SEED}/profiles/evimed-runtime/node_modules/@evimed/dsh-socket/package.json")")"; \
  case "${installed}" in "${DSH_HOME_SEED}"/*) ;; *) echo "refusing to write outside the seed: ${installed}" >&2; exit 1;; esac; \
  rm -rf "${installed}"; \
  mkdir -p "${installed}"; \
  cp -a /opt/evimed/socket/. "${installed}/"; \
  test -s "${installed}/dist/client.js"; \
  DSH_HOME="${DSH_HOME_SEED}" dsh --profile evimed-runtime --dump-config > /opt/evimed/dump-config.baseline.json; \
  test -s /opt/evimed/dump-config.baseline.json; \
  diff -u /opt/evimed/committed-dump-config.baseline.json /opt/evimed/dump-config.baseline.json; \
  node /usr/local/bin/evimed-profile-seed.mjs seal "${DSH_HOME_SEED}" evimed-runtime; \
  chmod -R a-w "${DSH_HOME_SEED}"

COPY deploy/runtime-dsh/build-smoke.sh /usr/local/bin/evimed-build-smoke
COPY deploy/runtime-dsh/build-smoke-patch.yml /usr/local/share/evimed/build-smoke-patch.yml
RUN set -eux; \
  chmod 0755 /usr/local/bin/evimed-build-smoke; \
  SOCKET_VERSION="${SOCKET_VERSION}" /usr/local/bin/evimed-build-smoke

ARG RELEASE_ID=untracked
ARG SOURCE_REVISION=unknown
ARG BUILD_CREATED=1970-01-01T00:00:00.000Z
LABEL org.opencontainers.image.version="${RELEASE_ID}"
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"
LABEL org.opencontainers.image.created="${BUILD_CREATED}"

WORKDIR /workspace
