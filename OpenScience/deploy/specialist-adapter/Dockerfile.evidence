ARG PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim-bookworm
FROM ${PYTHON_BASE_IMAGE}

ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    EVIMED_PUBLIC_CONNECTORS_ENABLED=true \
    EVIMED_PHARMACY_REFERENCE_DB=/data/pharmacy-reference.sqlite \
    EVIMED_DRUG_LABEL_DB=/data/drug-label-index.sqlite

WORKDIR /adapter
# The adapter's requirements.lock, when present, is what is installed: every
# version pinned for this image's Python
# (OpenScience/scripts/ops/compile-engine-locks.sh).
COPY OpenScience/deploy/specialist-adapter/requirements.txt OpenScience/deploy/specialist-adapter/requirements.loc[k] /tmp/adapter-requirements/
RUN set -eux; \
    requirements=/tmp/adapter-requirements/requirements.txt; \
    if [ -f /tmp/adapter-requirements/requirements.lock ]; then requirements=/tmp/adapter-requirements/requirements.lock; fi; \
    pip install --index-url "${PIP_INDEX_URL}" --no-cache-dir -r "${requirements}"; \
    rm -rf /tmp/adapter-requirements

COPY OpenScience/deploy/specialist-adapter/evimed_specialist_adapter ./evimed_specialist_adapter
COPY OpenScience/deploy/specialist-adapter/Dockerfile OpenScience/deploy/specialist-adapter/Dockerfile.evidence OpenScience/deploy/specialist-adapter/requirements.txt /adapter/
# The lock this image was installed from, where host-engine-delta.sh reads it.
COPY OpenScience/deploy/specialist-adapter/requirements.txt OpenScience/deploy/specialist-adapter/requirements.loc[k] /adapter/
RUN python -m evimed_specialist_adapter.audit_receipt --write-adapter-manifest /adapter/adapter-evidence.json
COPY OpenScience/runtime/mcp/evimed-research /mcp
RUN python -m compileall -q /adapter/evimed_specialist_adapter /mcp

# APP_VERSION is label metadata, not an input to package installation or smoke checks.
ARG APP_VERSION=1.0.0
LABEL org.opencontainers.image.title="EviMed Drug Evidence Adapters" \
      org.opencontainers.image.version="${APP_VERSION}"

VOLUME ["/data"]
EXPOSE 8026
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import json,urllib.request; value=json.load(urllib.request.urlopen('http://127.0.0.1:8026/health', timeout=3)); raise SystemExit(0 if value.get('ready') else 1)"

CMD ["uvicorn", "evimed_specialist_adapter.evidence_service:app", "--host", "0.0.0.0", "--port", "8026", "--no-access-log"]
