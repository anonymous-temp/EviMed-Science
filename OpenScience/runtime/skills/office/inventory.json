{
  "schemaVersion": 1,
  "license": "MIT",
  "provenance": "EviMed first-party clean-room implementation",
  "policy": {
    "delivery": {
      "contractVersion": 1,
      "defaultEnabledTier": "executable",
      "executable": {
        "docx": {
          "entrypoints": [
            "scripts/create_docx.py",
            "scripts/docx_tool.py"
          ],
          "dependencies": [
            "python>=3.11",
            "python-docx==1.2.0",
            "pandoc"
          ],
          "artifacts": [
            "document.docx"
          ],
          "smoke": "minimal-docx"
        },
        "pdf": {
          "entrypoints": [
            "scripts/create_pdf.py",
            "scripts/pdf_tool.py"
          ],
          "dependencies": [
            "python>=3.11",
            "pdfplumber==0.11.7",
            "pypdf==6.7.0",
            "pandoc",
            "playwright",
            "chromium",
            "fonts-noto-cjk",
            "fonts-texgyre-math",
            "libreoffice-kit"
          ],
          "artifacts": [
            "document.pdf"
          ],
          "smoke": "minimal-pdf"
        },
        "pptx": {
          "entrypoints": [
            "scripts/create_pptx.py",
            "scripts/pptx_tool.py"
          ],
          "dependencies": [
            "python>=3.11",
            "python-pptx==1.0.2",
            "libreoffice-kit"
          ],
          "artifacts": [
            "presentation.pptx"
          ],
          "smoke": "minimal-pptx"
        },
        "xlsx": {
          "entrypoints": [
            "scripts/create_xlsx.py",
            "scripts/xlsx_tool.py"
          ],
          "dependencies": [
            "python>=3.11",
            "openpyxl==3.1.5",
            "XlsxWriter==3.2.9",
            "libreoffice-kit"
          ],
          "artifacts": [
            "workbook.xlsx"
          ],
          "smoke": "minimal-xlsx"
        }
      },
      "conditional": {},
      "instructionOnly": [],
      "smokeFixtures": {
        "note": "The four create_* exporters are first-party smoke fixtures: the dependency-light baseline that proves the artifact chain without the pinned libraries. The flows a person asks for (read, edit in place, create) are the *_tool.py helpers and the SKILL.md text, exercised on real files by shared/test_office_flows.py.",
        "tests": [
          "shared/test_render_document.py",
          "shared/test_office_flows.py"
        ]
      }
    },
    "libreofficeKit": {
      "package": "@deepseek-ai/libreoffice-kit",
      "source": "the DSH kernel's own closure (deps-version.json dsh pin); MPL-2.0, prebuilt WebAssembly LibreOffice",
      "use": "shared/office_kit.py finds the CLI in the global kernel install or the sealed profile; render, convert, recalculate",
      "installedBy": "nothing extra: the image builds no system LibreOffice"
    }
  }
}
