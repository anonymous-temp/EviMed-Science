               <text>
                  <paragraph>NDC 79903-304-30</paragraph>
                  <paragraph>SAFE FOR NEWBORNS</paragraph>
                  <paragraph>
                     <content styleCode="bold">SALINE SPRAY + DROPS</content>
                  </paragraph>
                  <paragraph>Beathe Easy</paragraph>
                  <paragraph>Gently Wash Away Mucus</paragraph>
                  <list listType="unordered">
                     <item>No Artificial Flavors</item>
                     <item>No Artificial Dyes</item>
                     <item>No Parabens</item>
                  </list>
                  <paragraph>1 FL OZ (30 mL)</paragraph>
                  <paragraph>To use as a dropper:</paragraph>
                  <paragraph>Hold bottle upside down and squeeze lightly.</paragraph>
                  <paragraph>To use as a gentle sprayer:</paragraph>
                  <paragraph>Hold bottle upright and squeeze firm.</paragraph>
                  <paragraph>DO NOT USE IF IMPRINTED PLASTIC NECKBAND IS BROKEN OR MISSING</paragraph>
