      "sessionId": {
        "type": "string",
        "maxLength": 120
      },
      "attended": {
        "const": true
      },
      "messages": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "text",
            "saidAt"
