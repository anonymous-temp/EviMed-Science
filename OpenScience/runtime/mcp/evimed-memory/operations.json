                "user",
                "assistant"
              ],
              "description": "Which turns were the user's decides what may be recorded as explicit, so getting this wrong is not cosmetic."
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            }
          }
        }
      }
    },
    "required": [
      "messages"
    ]
  },
  {
    "name": "observations",
    "method": "POST",
    "path": "/observations",
    "capability": null,
    "query": [],
    "description": "Observe one prescription edit",
    "properties": {
      "observationId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "description": "The integrator's id for this edit; the same id posted twice is one edit."
      },
      "syndrome": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "The syndrome (证候) the formula was for. No digits."
      },
      "lineage": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "The lineage (诊疗思路) chosen, when one was."
      },
      "stage": {
        "type": "string",
        "enum": [
          "M04"
        ],
        "default": "M04"
      },
      "changes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "from",
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "replace"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[\\p{Script=Han}A-Za-z·（）()]{1,24}$",
                  "description": "A herb's name: letters, no digits — a dose is never observed."
                },
                "to": {
                  "type": "string",
                  "pattern": "^[\\p{Script=Han}A-Za-z·（）()]{1,24}$",
                  "description": "A herb's name: letters, no digits — a dose is never observed."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "herb"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "add"
                },
                "herb": {
                  "type": "string",
                  "pattern": "^[\\p{Script=Han}A-Za-z·（）()]{1,24}$",
                  "description": "A herb's name: letters, no digits — a dose is never observed."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "herb"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "remove"
                },
                "herb": {
                  "type": "string",
                  "pattern": "^[\\p{Script=Han}A-Za-z·（）()]{1,24}$",
                  "description": "A herb's name: letters, no digits — a dose is never observed."
                }
              }
            }
          ]
        }
      }
    },
    "required": [
      "syndrome",
      "changes"
    ]
  },
