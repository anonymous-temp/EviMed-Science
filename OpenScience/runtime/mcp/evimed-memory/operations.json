  {
    "name": "conversations",
    "method": "POST",
    "path": "/conversations",
    "capability": "conversationIngest",
    "query": [],
    "description": "Submit one complete, attended external session for native extraction. Repost the identical batch to read its receipt. Only forward a real host-captured attended transcript. Never reconstruct human turns.",
