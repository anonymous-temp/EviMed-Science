{
  "name": "@ai4s/server",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/index.mjs",
    "start": "node src/index.mjs",
    "start:controller": "node src/runtimeControllerIndex.mjs",
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/runtimeManager.test.mjs test/security.test.mjs test/server.test.mjs",
    "test:contract": "node --test test/hosted-web.e2e.test.mjs",
    "test:e2e": "node ../../scripts/ops/hosted-production-e2e.mjs",
    "lint": "eslint src test --ext .mjs --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openid-client": "6.8.4",
    "pg": "8.16.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}
