  "citation": "Asaumi 等，2018，CPT: Pharmacometrics & Systems Pharmacology 7(3):186-196",
  "premises": [
   {
    "key": "pbpk_model",
    "label": "用的是什么模型",
    "value": "已发表的全身生理药代动力学模型（Asaumi 等，2018，CPT: Pharmacometrics & Systems Pharmacology）：利福平反复给药诱导肠壁和肝脏的 CYP3A4，咪达唑仑在同一套生理参数上被代谢；参数和方程取自作者公开的模型代码，没有改动",
    "source": "literature",
    "decisive": true,
    "reason": null
   },
   {
    "key": "pbpk_person",
    "label": "模拟的是谁",
    "value": "一个体重 80 kg 的典型健康成人：没有个体差异、基因型和疾病，所以这里的倍数是模型的典型值，不是某个患者会得到的值",
    "source": "default",
    "decisive": true,
    "reason": null
   },
   {
    "key": "pbpk_regimen",
    "label": "给药方案",
    "value": "利福平 75 mg，每 24 小时一次，共 7 次；咪达唑仑口服 3 mg，在最后一次利福平后 12 小时给药",
    "source": "given",
    "decisive": true,
    "reason": null
   },
   {
    "key": "pbpk_clinical",
    "label": "和临床研究比",
    "value": "已发表的临床研究里，利福平合用后口服咪达唑仑的面积比彼此相差近八倍；模型给出的是它们之间的一个典型值，对诱导最强的几项研究偏高。论文本身没有给出合用后面积比的数值，只说拟合“吻合良好”",
    "source": "literature",
    "decisive": false,
    "reason": null
   },
   {
    "key": "pbpk_scope",
    "label": "模型里有什么、没有什么",
    "value": "只有利福平的诱导：肠壁和肝脏 CYP3A4 的合成按它在细胞里的游离浓度上升，降解速率不变；没有抑制剂，也没有其他诱导剂",
    "source": "default",
    "decisive": false,
    "reason": null
   },
   {
    "key": "assumed_victim.route",
    "label": "给药途径",
    "value": "口服（the usual way midazolam is given in an interaction study）",
    "source": "default",
    "decisive": false,
    "reason": null
   },
   {
    "key": "assumed_weightKg",
    "label": "体重",
    "value": "80 kg（the body weight of the published code (every clearance, flow and volume of the model is per kilogram)）",
    "source": "default",
    "decisive": false,
    "reason": null
   },
   {
    "key": "assumed_horizonH",
    "label": "观察时长",
    "value": "48 小时（long enough for the area under the curve to be complete: midazolam's half-life is a few hours）",
    "source": "default",
    "decisive": false,
    "reason": null
   },
   {
    "key": "assumed_perpetrator.intervalH",
    "label": "合用药物的给药间隔",
    "value": "24 小时（once a day）",
    "source": "default",
    "decisive": false,
    "reason": null
   },
   {
    "key": "assumed_perpetrator.gapH",
    "label": "最后一次合用药物到服药的间隔",
    "value": "12 小时（midazolam is given 12 hours after the last dose of the perpetrator）",
    "source": "default",
    "decisive": false,
    "reason": null
   }
  ],
  "limited": null
