# Test-only fixed SDK fixture. No customer, provider or control-plane configuration.
ARG NODE_IMAGE
FROM ${NODE_IMAGE}
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY platform/ /fixture/platform/
COPY install-sdk.mjs make-fixtures.mjs /fixture/
COPY validate-personal-skill.mjs /opt/evimed/socket/scripts/validate-personal-skill.mjs
COPY catalogue-fixture.mjs fixture.mjs /fixture/
RUN NODE_USE_ENV_PROXY=1 node /fixture/install-sdk.mjs && node /fixture/make-fixtures.mjs \
 && mkdir -p /opt/evimed/socket /fixture/platform/node_modules \
 && ln -s /fixture/platform/node_modules /opt/evimed/socket/node_modules
ENV NARB_DISABLE_NATIVE_CACHE=1 DSH_TELEMETRY_DISABLED=1
LABEL io.evimed.acceptance.fixture="unverified"
USER 10001:10001
ENTRYPOINT ["node", "/fixture/fixture.mjs"]
CMD []
