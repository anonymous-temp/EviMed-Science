{
  "name": "evimed-science",
  "version": "0.1.3",
  "private": true,
  "description": "EviMed medical research agent platform for traceable open-domain and specialist research.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @ai4s/desktop dev",
    "dev:server": "pnpm --filter @ai4s/server dev",
    "dev:evimed": "node scripts/dev/start-evimed-local.mjs",
    "configure:evimed-local": "node scripts/dev/configure-local-secrets.mjs",
    "build": "pnpm --filter @ai4s/desktop build",
    "build:web": "VITE_OPEN_SCIENCE_API_URL=/api pnpm --filter @ai4s/desktop build",
    "test": "pnpm --filter @ai4s/desktop test",
    "test:mcp": "python3 -m unittest discover -s runtime/mcp/evimed-research/test -p 'test_*.py'",
    "test:drug-evidence-eval": "python3 -m unittest discover -s evals/drug-evidence-quality -p 'test_*.py'",
    "eval:drug-evidence": "python3 evals/drug-evidence-quality/run_benchmark.py",
    "test:server": "pnpm --filter @ai4s/server test",
    "test:web": "pnpm test:mcp && pnpm test:server && pnpm typecheck && pnpm test",
    "test:web:e2e": "pnpm --filter @ai4s/server test:e2e",
    "audit:hosted-compliance": "node scripts/ops/audit-hosted-compliance.mjs",
    "audit:saas-alignment": "node scripts/ops/audit-saas-alignment.mjs",
    "audit:source-secrets": "node scripts/ops/audit-source-secrets.mjs",
    "audit:capabilities": "python3 evals/capability-audit/verify_release_audit.py",
    "audit:dependencies": "pnpm audit --prod --audit-level moderate --registry=https://registry.npmjs.org",
    "configure:monitoring": "node scripts/ops/configure-monitoring.mjs",
    "check:monitoring": "node scripts/ops/configure-monitoring.mjs --check",
    "probe:monitoring": "node scripts/ops/configure-monitoring.mjs --probe",
    "configure:backup": "node scripts/ops/configure-backup.mjs",
    "check:backup": "node scripts/ops/configure-backup.mjs --check",
    "configure:local-auth": "node scripts/ops/configure-local-auth.mjs",
    "check:local-auth": "node scripts/ops/configure-local-auth.mjs --check",
    "configure:production-state": "node scripts/ops/configure-production-state.mjs",
    "check:production-state": "node scripts/ops/configure-production-state.mjs --check",
    "configure:oidc": "node scripts/ops/configure-oidc.mjs",
    "check:oidc": "node scripts/ops/configure-oidc.mjs --check",
    "release:manifest": "node scripts/ops/generate-release-manifest.mjs",
    "check:release-manifest": "node scripts/ops/generate-release-manifest.mjs --check",
    "verify:release-manifest": "node scripts/ops/generate-release-manifest.mjs --check --verify-images",
    "smoke:deployment": "node scripts/ops/deployment-smoke.mjs",
    "preflight:host": "node scripts/ops/host-preflight.mjs",
    "preflight:deepseek": "node scripts/ops/deepseek-compatibility-preflight.mjs",
    "preflight:deepseek:release": "node scripts/ops/deepseek-opencode-release-gate.mjs",
    "backup:object": "node scripts/ops/object-backup.mjs upload",
    "restore:object": "node scripts/ops/object-backup.mjs download",
    "probe:object": "node scripts/ops/object-backup.mjs probe",
    "migrate:data": "bash scripts/ops/migrate-data-dir.sh",
    "typecheck": "pnpm --filter @ai4s/desktop typecheck",
    "check:tauri": "cd apps/desktop/src-tauri && cargo check",
    "ci:web": "pnpm test:web && pnpm audit:source-secrets && pnpm audit:hosted-compliance && pnpm audit:saas-alignment && pnpm audit:capabilities && pnpm audit:dependencies && pnpm build:web",
    "lint": "pnpm --filter @ai4s/desktop lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0",
  "pnpm": {
    "overrides": {
      "exceljs>uuid": "11.1.1",
      "pptx-preview>echarts": "6.1.0",
      "pptx-preview>uuid": "11.1.1"
    }
  }
}
