    "kind": "bounded_method_verification",
    "establishes": [
      "为每个合成来源片段找到排除条件所需的事实，并保留逐字原文与出处区间",
      "在进入确定性评估之前，把「判不了」写成显式状态",
      "记录时间语义（当前 / 历史 / 未知）而不新增阈值"
    ],
    "does_not_establish": [
      "任何入排判定结果或人群规模",
      "任何临床准确性、匹配准确率或需筛人数",
      "对任何真实个体的结论"
    ],
    "patientData": "none",
    "syntheticOnly": true,
    "containsPopulationCounts": false,
    "containsPatientLists": false,
    "platformStudyOrResultRegistered": false,
    "engineInvoked": false
  },
  "annotationPolicy": {
    "whatIsAnnotated": "事实与出处，不是最终入排结论。前状态按 protocol.json 的要求与 unknownPolicy 给出，属于规则层面的读法。",
    "excludedOnPurpose": "不记录任何人数、比例、合格数、排除数或候选名单；四个片段是合成来源，不是患者队列。",
    "polarityRule": "只有原文确有的用药才写成 affirmed；已停用写成 negated 并标注为历史暴露，不写成「从未使用」；缺失的历史既不是阳性也不是阴性。",
    "missingIsNotDenial": "缺少用药史时结论是 unknown，不是「没有暴露」；写成「从未使用」需要原文的否认原句。",
    "recencyRule": "原文给出的停用时点照原样记录（含单位），不换算、不推断；定义没有阈值就不在标注里造一个。",
    "spanUnit": "utf16_code_units，区间为该引文在来源摘录内的位置。"
  },
