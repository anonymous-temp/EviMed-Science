      "evidenceNeeded": ["出生日期或年龄记录"],
      "applicability": null
    },
    {
      "id": "crit-exclusion-current-glucocorticoid",
      "kind": "exclusion",
      "criterionType": "concomitant_medication",
      "requirement": {
        "op": "compare",
        "variable": "systemic_glucocorticoid_exposure_state",
        "comparator": "ne",
        "value": "current"
      },
      "sourceText": "exclude CURRENT systemic glucocorticoid exposure",
      "sourceLocator": { "origin": "task-specified study definition" },
      "evidenceNeeded": ["用药史", "计划给药或用药记录", "本次评估日的用药清单"],
      "applicability": null
    }
  ],
  "criteriaAnnotations": [
    {
      "criterionId": "crit-exclusion-current-glucocorticoid",
      "contextAnnotation": {
        "readingOfTheCriterion": "本条排除的是判定时点仍在使用的全身性糖皮质激素暴露。",
        "notExcluded": "既往使用、已停用（停用时间在历史区间内）。",
        "excluded": "判定时点仍在使用的暴露，包括前一天开始且仍在继续的用药。",
        "unknown": "用药史缺失或不足，无法确定判定时点的暴露状态。",
