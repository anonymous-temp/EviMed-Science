# LX: production learning composition (L3 arm E): official packs flat, account learning on, every P1 switch off (today's behaviour).
# run_lx.mjs turns OPEN_SCIENCE_LEARNING_TOOLCHAIN_ROUTINE_ENABLED on for arm tc-on and EVAL_ADD_ONLY on for arm add-only.
OPEN_SCIENCE_OFFICIAL_PACKS_ENABLED=true
OPEN_SCIENCE_LEARNING_ENABLED=true
OPEN_SCIENCE_METHOD_PYRAMID_ENABLED=false
OPEN_SCIENCE_METHOD_OFFICIAL_IN_LOOP_ENABLED=false
OPEN_SCIENCE_METHOD_CARD_EVIDENCE_ENABLED=false
OPEN_SCIENCE_LEARNING_TOOLCHAIN_ROUTINE_ENABLED=false
OPEN_SCIENCE_OFFICIAL_PROMOTION_ENABLED=false
OPEN_SCIENCE_LEARNING_CONCURRENCY=1
OPEN_SCIENCE_LEARNING_WINDOW=
OPEN_SCIENCE_LEARNING_CONSOLIDATION_INTERVAL_MS=86400000
EVAL_METHOD_RANKER=1
EVAL_DEFER_LEARNING=1
EVAL_ADD_ONLY=0
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES=1
OPEN_SCIENCE_MAX_RUNNING_RUNTIMES_PER_USER=1
