    {
      "name": "mcp__evimed__literature_search",
      "source": "mcp",
      "description": "Search the biomedical and scientific literature (PubMed and the other configured sources) through the EviMed evidence adapter. By default the answer leads with PubMed's Best Match records and adds the EviMed index's records that PubMed did not return (up to `limit` from each; an index record is compact — abstract cut to 800 characters, no AI summary); `databases` [\"pubmed\"] asks PubMed alone and [\"internal\"] asks the EviMed index alone with its full abstracts and AI summaries. Supply `relation` instead to retrieve the literature PubTator3 records a relation in — papers that assert the relation, not papers where both terms merely co-occur; get the concept identifiers from term_normalize. Supply `pmids` instead to fetch the abstracts, publication types and MeSH headings of PubMed records you have screened in (up to 60); each abstract is preserved and quotable, and past about 12,000 characters an item names its preserved file instead of carrying the text. Public results are bibliographic metadata unless abstract or full-text fields are explicitly present; never infer study design, evidence level, outcomes, or effect estimates from a title.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "pmids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "type": "string",
              "pattern": "^\\s*(?:PMID\\s*:?\\s*)?\\d{1,9}\\s*$"
            }
          },
          "relation": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "pattern": "^@[A-Z]+_[A-Za-z0-9_,.:+-]{1,180}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "treat",
                  "cause",
                  "prevent",
                  "inhibit",
                  "stimulate",
                  "interact",
                  "drug_interact",
                  "associate",
                  "compare",
                  "cotreat",
                  "positive_correlate",
                  "negative_correlate"
                ]
              },
              "object": {
                "type": "string",
                "pattern": "^@[A-Z]+_[A-Za-z0-9_,.:+-]{1,180}$"
              }
            },
            "additionalProperties": false,
            "required": [
              "subject"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "PubMed route: results to skip. data.outcome says when more exist and what to pass."
          },
          "dateFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dateTo": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "articleTypes": {
            "type": "array",
            "maxItems": 15,
            "items": {
              "type": "string",
              "enum": [
                "系统综述/Meta分析",
                "指南/共识",
                "传统综述",
                "随机对照试验",
                "临床试验",
                "队列研究",
                "病例对照研究",
                "横断面研究",
                "病例系列",
                "病例报告",
                "经济学评价",
                "专家意见和评价",
                "动物实验",
                "体外实验",
                "其他"
              ]
            },
            "description": "EviMed's own study-type labels, e.g. 随机对照试验 for randomized controlled trials."
          },
          "hasPdf": {
            "type": "boolean"
          },
          "language": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "minImpactFactor": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "maxImpactFactor": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "journalTiers": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "北大核心",
                "科技核心",
                "南大核心"
              ]
            }
          },
          "databases": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "internal",
                "pubmed",
                "crossref"
              ]
            },
            "description": "Default (omit it): PubMed first, then the EviMed index's extra records, compact. [\"pubmed\"]: PubMed only. [\"internal\"]: the EviMed index only, full abstracts and AI summaries. [\"crossref\"]: Crossref."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "declaredBy": "scripts/dev/build-tool-graph.mjs",
        "note": "MCP publishes no output schema for this tool; these are the result fields an edge may depend on.",
        "fields": [
          {
            "path": "items[].pmid",
            "type": "pmid"
          },
          {
            "path": "items[].doi",
            "type": "doi"
          }
        ]
      },
      "typeTags": [
        "mesh_term",
        "pmid",
        "source_id"
      ],
      "requiredTypeTags": [],
      "outputTypeTags": [
        "doi",
        "pmid"
      ],
      "stateEffect": "none"
    },
    {
      "name": "mcp__evimed__locate_quote",
      "source": "mcp",
      "description": "Find a quotation in a source this run preserved, judged exactly as the delivery gate judges a claim's supportQuote (case, quotation marks, dashes, whitespace, full-width forms, CJK spacing, PDF line breaks, inline citation markers and marked … elisions are forgiven; anything else is not). found=true only for a match the gate accepts; each match has character offsets into the preserved file, its line and context. When not found, match=near passages show what the source actually says, to quote instead. Read-only.",
