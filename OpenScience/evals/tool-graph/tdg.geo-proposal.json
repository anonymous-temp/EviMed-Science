              "lock_questions",
              "journey",
              "strategy",
              "sources",
              "targets",
              "articles",
              "placement_plan",
              "owned_links",
              "step",
              "value",
              "research",
              "actions"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object"
            }
          },
          "data": {
            "type": "object",
            "description": "Imported questions: rows[{text,originalId?,originalGroup?,clientTags?,kind?,sourceUrl?,collectedAt?,pool?,journeyStage?,audience?,isMeasured?,classificationStatus?}], contract{samplingMode:one_shot|recurring,engines,repeats(one_shot=1),metricIds,reportPresentation:summary|detailed,sourceBasis:answers|answers_and_project_sources},requestKey. Preserve original text; kind defaults client; real requires URL and date; classificationStatus is unclassified|suggested|confirmed. start_diagnosis:{version,requestKey}; recover_diagnosis:{roundId,requestKey,jobIds,acknowledgeUnknown?} for failed calls. Read diagnosis_progress with filter.round before recovery. Never default acknowledgeUnknown to true; preserve requestKey on retries."
          }
