      "id": "m01",
      "kind": "project_fact",
      "scope": "project",
      "summary": "成人慢性心衰患者，射血分数低于 40%"
    },
    {
      "id": "m02",
      "kind": "project_fact",
      "scope": "project",
      "summary": "SGLT2 抑制剂联合标准治疗，对照组为标准治疗加安慰剂"
    },
    {
      "id": "m03",
      "kind": "project_fact",
      "scope": "project",
      "summary": "主要终点为心衰再入院或心血管死亡"
    },
    {
      "id": "m04",
      "kind": "project_fact",
      "scope": "project",
      "summary": "起始剂量 10 mg 每日一次"
    },
    {
      "id": "m05",
      "kind": "project_fact",
      "scope": "project",
      "summary": "研究设计改为双盲，由独立统计师揭盲"
    },
    {
      "id": "m06",
      "kind": "project_fact",
      "scope": "project",
      "summary": "主分析采用意向性治疗人群"
    },
    {
      "id": "m07",
      "kind": "project_fact",
      "scope": "project",
      "summary": "用 Cox 比例风险模型，协变量按预先指定的清单"
    },
    {
      "id": "m08",
      "kind": "project_fact",
      "scope": "project",
      "summary": "缺失数据用多重插补，不做末次观测结转"
    },
    {
      "id": "m09",
      "kind": "follow_up",
