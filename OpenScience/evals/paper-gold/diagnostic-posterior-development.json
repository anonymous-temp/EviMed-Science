            "test": 3
          }
        }
      },
      "expected": {
        "results": {
          "test": {
            "posteriorOdds": 0.75,
            "posteriorProbability": 0.42857142857142855
          }
        }
      },
      "absoluteTolerance": 1e-10
    },
    {
