   "rowCount": 12,
   "rows": [
    [
     {
      "text": "Development"
     },
     {
      "text": "CPU is the easiest to program, then GPU, then FPGA"
     },
     {
      "text": "CPU"
     }
    ],
    [
     {
      "text": "Size"
     },
     {
      "text": "Both FPGA and CPU have smaller volume solutions due to their lower power consumption"
     },
     {
      "text": "FPGA-CPU"
     }
    ],
    [
     {
      "text": "Customization"
     },
     {
      "text": "Broader flexibility is provided by FPGA"
     },
     {
      "text": "FPGA"
     }
    ],
    [
     {
      "text": "Ease of change"
     },
     {
      "text": "Easier way to vary application functionality is provided by GPU and CPU"
     },
     {
      "text": "GPU-CPU"
     }
    ],
    [
     {
      "text": "Backward compatibility"
     },
     {
      "text": "Transferring RTL to novel FPGA requires additional work. Furthermore, GPU has less stable architecture than CPU"
     },
     {
      "text": "CPU"
     }
    ],
    [
     {
      "text": "Interfaces"
     },
     {
      "text": "Several varieties of interfaces can be implemented using FPGA"
     },
     {
      "text": "FPGA"
     }
    ],
    [
     {
      "text": "Processing/$"
     },
     {
      "text": "FPGA configurability assists utilization in wider acceleration space. Due to the considerable processing abilities, GPU wins"
     },
     {
      "text": "FPGA-GPU"
     }
    ],
    [
     {
      "text": "Processing/watt"
     },
     {
      "text": "Customized designs can be optimized"
     },
     {
      "text": "FPGA"
     }
    ],
    [
     {
      "text": "Timing latency"
     },
     {
      "text": "Implemented FPGA algorithm offers deterministic timing, which is in turn much faster than GPU"
     },
     {
      "text": "FPGA"
     }
    ],
    [
     {
      "text": "Large data analysis"
     },
     {
      "text": "FPGA performs well for inline processing, while CPU supports storage capabilities and largest memory"
     },
     {
      "text": "FPGA-CPU"
     }
    ],
    [
     {
      "text": "DCNN inference"
     },
     {
      "text": "FPGA has lower latency and can be customized"
     },
     {
      "text": "FPGA"
     }
    ],
    [
     {
      "text": "DCNN training"
     },
     {
      "text": "Greater float-point capabilities provided by GPU"
     },
     {
      "text": "GPU"
     }
    ]
