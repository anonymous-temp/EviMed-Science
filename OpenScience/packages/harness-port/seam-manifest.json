{
  "dsh": "0.1.2-alpha.5",
  "cordis": "4.0.2",
  "services": {
    "required": [
      "tools",
      "systemPrompt",
      "agents",
      "sessions",
      "subagents",
      "agentPresets",
      "shell"
    ],
    "optional": [
      "storageDomain",
      "skills",
      "fs",
      "jobs",
      "workflowEngine"
    ]
  },
  "events": {
    "toolPolicy": "tools/pre-execute",
    "toolWrap": "tools/execute",
    "toolPost": "tools/post-execute",
    "toolObserved": "tools/result",
    "sessionEvent": "session/event",
    "sessionStart": "agent/session-start",
    "preStep": "agent/pre-step",
    "turnStopping": "agent/turn-stopping",
    "domainChanged": "domain/changed"
  },
  "sessionEventTypes": [
    "turn/start",
    "turn/end",
    "step/start",
    "step/end",
    "user/message",
    "assistant/chunk",
    "assistant/message",
    "tool/call",
    "tool/result",
    "subagent/descriptor",
    "agent-preset/selected",
    "compaction/start",
    "compaction/summary",
    "compaction/end",
    "tool-workflow/run-start",
    "tool-workflow/run-end",
    "tool-workflow/agent-start",
    "tool-workflow/agent-end"
  ],
  "turnEndKinds": [
    "completed",
    "aborted",
    "blocked",
    "error",
    "max-tokens",
    "interrupted"
  ],
  "preToolDecisionKinds": [
    "allow",
    "deny",
    "ask"
  ],
  "preStepDecisionKinds": [
    "enter",
    "reject"
  ],
  "sessionStartSources": [
    "startup",
    "resume",
    "clear",
    "compact"
  ],
  "subagentProviders": {
    "spawn": "spawn",
    "fork": "fork"
  },
  "packages": {
    "@deepseek-ai/cordis": "peer",
    "@deepseek-ai/schemastery": "re-exported",
    "@deepseek-ai/dsh-tools": "dependency",
    "@deepseek-ai/dsh-storage-domain": "dependency",
    "@deepseek-ai/dsh-llm": "types-only",
    "@deepseek-ai/dsh-persona": "config-row",
    "@deepseek-ai/dsh-mcp-client": "config-row",
    "@deepseek-ai/dsh-agent-presets": "config-row",
    "@deepseek-ai/dsh-skill-filesystem": "config-row",
    "@deepseek-ai/dsh-compaction-basic": "config-row",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "config-row",
    "@deepseek-ai/dsh-tool-subagent": "config-row",
    "@deepseek-ai/dsh-tool-subagent-control": "config-row",
    "@deepseek-ai/dsh-workflow-worker-thread": "config-row",
    "@deepseek-ai/dsh-tool-workflow": "config-row",
    "@deepseek-ai/dsh-tool-bash": "config-row",
    "@deepseek-ai/dsh-tool-fs": "config-row",
    "@deepseek-ai/dsh-tool-fs-search": "config-row",
    "@deepseek-ai/dsh-tool-jobs": "config-row",
    "@deepseek-ai/dsh-tool-skill": "config-row",
    "@deepseek-ai/dsh-tool-ask-user": "config-row",
    "@deepseek-ai/dsh-llm-deepseek": "config-row",
    "@deepseek-ai/dsh-storage-json": "config-row"
  },
  "wire": {
    "unary": [
      "session/create",
      "session/prompt",
      "session/cancel",
      "session/page",
      "session/fork",
      "session/list",
      "subagents/list",
      "skills/list",
      "agentPresets/list"
    ],
    "denied": [
      "agentPresets/copy",
      "agentPresets/deletePreset",
      "agentPresets/read",
      "agentPresets/select",
      "agentTeams/createTask",
      "agentTeams/updateTask",
      "agentTeams/view",
      "credentials/describe",
      "credentials/set",
      "credentials/unset",
      "directoryPicker/createDirectory",
      "directoryPicker/list",
      "directoryPicker/pick",
      "goals/clear",
      "goals/complete",
      "goals/create",
      "goals/edit",
      "goals/pause",
      "goals/resume",
      "llm/discoverModels",
      "messageFeedback/delete",
      "messageFeedback/list",
      "messageFeedback/put",
      "session/attachment",
      "session/modelCatalog",
      "session/openWorkspacePath",
      "session/rename",
      "session/search",
      "session/selectModel",
      "session/updateQueue",
      "sessionReferenceResolver/candidates",
      "settings/describe",
      "settings/update",
      "subagents/interruptByParent",
      "subagents/prompt",
      "workspace/archiveSession",
      "workspace/create",
      "workspace/delete",
      "workspace/insertBefore",
      "workspace/insertSessionBefore",
      "workspace/rename"
    ],
    "downlink": [
      "/api/events.mux",
      "/api/events.host"
    ],
    "downlinkTransport": "websocket",
    "unaryArgs": {
      "session/create": [
        "request"
      ],
      "session/prompt": [
        "request"
      ],
      "session/cancel": [
        "request"
      ],
      "session/page": [
        "request"
      ],
      "session/fork": [
        "request"
      ],
      "session/list": [
        "_request"
      ],
      "subagents/list": [
        "parentSessionId"
      ],
      "skills/list": [
        "request"
      ],
      "agentPresets/list": []
    },
    "mux": "/api/remote.mux",
    "streamEndpoints": {
      "events": "$events",
      "session": "session/follow",
      "workspace": "workspace/follow"
    },
    "clientEnvelope": {
      "type": "client-request",
      "fields": [
        "type",
        "rpcId",
        "method",
        "payload"
      ],
      "payload": [
        "args"
      ]
    },
    "serverEnvelope": {
      "type": "server-response",
      "fields": [
        "type",
        "rpcId",
        "result"
      ],
      "result": [
        "ok",
        "value",
        "error"
      ]
    },
    "muxClientFrames": [
      "open",
      "cancel"
    ],
    "muxServerFrames": [
      "item",
      "error",
      "end"
    ],
    "eventStreamFrames": [
      "ready",
      "emit",
      "waterfall",
      "cancel"
    ],
    "sessionStreamFrames": [
      "snapshot",
      "event"
    ],
    "auth": "browser-session-cookie",
    "hostInteractionEvents": {
      "approval": "approval/request",
      "question": "user-questions/request"
    },
    "hostInteractionOutcomeKinds": [
      "result",
      "next",
      "rejected"
    ],
    "approvalOutcomes": [
      "allowed-once",
      "rejected",
      "cancelled",
      "unavailable"
    ],
    "gatewayEndpoints": {
      "hostInteractionResult": "$events/result"
    },
    "gatewayEndpointArgs": {
      "$events/result": [
        "clientId",
        "eventId",
        "outcome"
      ]
    }
  },
  "notes": {
    "sessionStatusAbsent": "There is no session status method. Running state arrives as an `api-session/status` emit on the Gateway-internal `$events` stream.",
    "hostDescribeRemoved": "0.1.2 removed host.describe with the rest of ApiProxy. Host facts arrive once, in the `$events` stream's opening `ready` frame. The readiness probe is session/list, which is a real wire call and therefore also proves authentication.",
    "methodsRenamed": "0.1.2 renamed every method from dotted to slashed and moved arguments into a named descriptor: session.list became session/list taking {_request}. Verified against a running 0.1.2-alpha.3 binary, which 404s the dotted form and names the missing args field itself.",
    "sessionIdNotInFrame": "A session's events arrive on the `session/follow` stream opened for that session and no longer carry a session id. Whatever opens the stream owns the pairing.",
    "noVersionField": "The wire protocol carries no version field, so method names matching does not prove frame shapes match. Golden frames are the only check that does."
  }
}
