{
  "name": "@evimed/domain",
  "version": "0.1.0",
  "type": "module",
  "description": "Pure EviMed domain vocabulary: contract kinds, gate rules, state machines, error codes, workspace layout. Browser-safe; its only dependency is the token table it re-exports.",
  "license": "MIT",
  "files": [
    "index.mjs",
    "src"
  ],
  "exports": {
    ".": "./index.mjs",
    "./answer-evidence-grade": "./src/answerEvidenceGrade.mjs",
    "./clinical-evidence": "./src/clinicalEvidence.mjs",
    "./design-tokens": "./src/designTokens.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --import ../../scripts/test/localhostProbeGuard.mjs --test test/*.test.mjs",
    "lint": "eslint src test index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonymous-temp/EviMed-Science.git",
    "directory": "OpenScience/packages/domain"
  },
  "directory": null,
  "dependencies": {
    "@evimed/design-tokens": "workspace:*"
  }
}
