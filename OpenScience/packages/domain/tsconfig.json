{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../../apps/desktop/node_modules/@types", "../../apps/server/node_modules/@types"]
  },
  "include": ["index.mjs", "src/**/*.mjs", "test/**/*.mjs"]
}
