{
  "name": "@evimed/dsh-socket",
  "version": "0.1.0",
  "type": "module",
  "description": "The EviMed socket: a DSH bundle carrying the evimed-universal composition, the orchestration guidance, and the run-side delivery gate.",
  "license": "MIT",
  "files": [
    "index.mjs",
    "plugins",
    "presets",
    "src",
    "cordis.patch.yml",
    "capabilities",
    "capability-skills",
    "client.mjs",
    "dist/client.js",
    "scripts/build-client.mjs"
  ],
  "exports": {
    ".": "./index.mjs",
    "./plugins/*": "./plugins/*.mjs",
    "./src/*": "./src/*.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./dist/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "eslint plugins src test scripts client.mjs index.mjs --ext .mjs --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/build-client.mjs && node ../../scripts/build/generate-capability-manifests.mjs --out packages/socket/capabilities && node -e \"require('node:fs').cpSync('../../capability-skills','capability-skills',{recursive:true})\"",
    "build:client": "node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@evimed/domain": "workspace:^0.1.0",
    "@evimed/harness-port": "workspace:^0.1.0",
    "dsh-cite": "0.3.2"
  },
  "bundledDependencies": [
    "@evimed/domain",
    "@evimed/harness-port"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonymous-temp/EviMed-Science.git",
    "directory": "OpenScience/packages/socket"
  },
  "directory": null
}
