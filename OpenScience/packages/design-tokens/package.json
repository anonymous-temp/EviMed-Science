{
  "name": "@evimed/design-tokens",
  "version": "2.1.3",
  "type": "module",
  "description": "EviMed design language 2.1: one token table, generated into CSS, a Tailwind preset, an Element Plus theme, an ECharts theme, the conversation kernel's theme override, a Figma token file and a DTCG 2025.10 export. Zero dependencies, browser-safe.",
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./contrast": "./src/contrast.mjs",
    "./css": "./src/css.mjs",
    "./kernel": "./src/kernel.mjs",
    "./artifacts": "./src/artifacts.mjs",
    "./tailwind": "./dist/tailwind-preset.js",
    "./tokens.css": "./dist/tokens.css",
    "./element-plus.css": "./dist/element-plus.css",
    "./echarts-theme.json": "./dist/echarts-theme.json",
    "./dsh-theme.json": "./dist/dsh-theme.json",
    "./figma-tokens.json": "./dist/figma-tokens.json",
    "./dtcg/*": "./dist/dtcg/*",
    "./release.json": "./src/release.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node src/generate.mjs",
    "check": "node src/generate.mjs --check",
    "record-release": "node src/generate.mjs --record-release",
    "test": "node --import ../../scripts/test/localhostProbeGuard.mjs --test test/*.test.mjs",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonymous-temp/EviMed-Science.git",
    "directory": "OpenScience/packages/design-tokens"
  }
}
