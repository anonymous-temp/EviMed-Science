# OS
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# Editors
.vscode/
.idea/

# Node
node_modules/
dist/
# ...except the design tokens' generated artifacts. They are the interface the
# Vue shell of EviMed consumes — another repository, which cannot run this
# monorepo's build — so they are reviewed like source and `pnpm tokens:check`
# fails when they go stale. Until the package is published to the private
# registry, a commit is how a token reaches the other front end.
!packages/design-tokens/dist/
dist-ssr/
*.local
.vite/
.turbo/
*.tsbuildinfo
coverage/

# Rust / Tauri
target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
.pytest_cache/

# Logs & caches
*.log
.cache/
.eslintcache
.superpowers/

# The owner's proprietary GEO method pack, unpacked by
# scripts/build/vendor-geo-skills.mjs. The repository is public: only the
# README that explains the directory is tracked.
runtime/skills/geo-private/*
!runtime/skills/geo-private/README.md

# Local runtime & secrets (never commit)
.ai4s-workbench/
.openscience-web-data/
secrets/
deploy/web/release-manifest.json
*.key
.env
.env.*
!.env.example
!**/.env.example

# Build artifacts / installers
*.dmg
*.app
*.exe
*.msi

# Bundled sidecar binaries (fetched per-platform; too large for git)
apps/desktop/src-tauri/binaries/

# Third-party skill packs (fetched by scripts/dev/fetch-skills.sh)
runtime/skills/external/

# Local demo recordings (too large for git)
videos/

# Local video-production tooling (fetched hyperframes skill packs)
.agents/
skills-lock.json

# Capability audit probe workspace (regenerated per run)
evals/capability-audit/tool-probe-workspace/

# Generated by prepack from capabilities/ and capability-skills/. Shipped in the
# npm tarball so a bundle installed without the control plane still has a
# capability catalogue; never committed, because the source of truth is the
# capability.yaml files.
packages/socket/capabilities/
packages/socket/capability-skills/

# Raw F0 session-stream recordings: megabytes of one run's wire, kept on the
# acceptance host. The bounded, verbatim selection that the tests read lives in
# apps/desktop/src/lib/__fixtures__/.
evals/session-stream/recordings/

# Brief drafts and their synthesis requests (scripts/dev/generate-briefs.mjs).
# Regenerated from the committed tool graphs and the execution receipts; nothing
# in here is corpus until the writing step has run and a human has reviewed it,
# and a draft with null prose committed by accident reads as a finished brief.
evals/tool-graph/generated/

# Live audit workspaces contain transient jobs and workload credentials.
evals/capability-audit/workspaces/
